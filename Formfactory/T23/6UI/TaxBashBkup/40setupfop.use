setupfop(){
    while true;
    do
   clear
    echo "tax-bash needs to know the path to fop."
    echo
    echo "In my version of Ubuntu there is a bash file "fop" in the bin directory."
    echo "This is reached first in the standard PATH variable."
    echo "It works OK, although it does give a warning about 'sun'."
    echo "I suggest that you not use this version."
    echo
    echo "I suggest that you control which version of fop you use."
    echo "Do this by downloading this version and then"
    echo "put the path to it at the start of your PATH variable."
    echo
    echo "The following steps will achieve that:"
    echo
    echo  "Download from the Apache FOP website"
    echo "the most recent tarball which currently is"
    echo "  fop-2.6.tar.gz"
    echo
    echo "Move this tarball from ~/Downloads to the directory of your choice."
    echo "I created the directory ~/Fop and moved the tarball there."
    echo
    echo "Change directory into ~/Fop and issue the following command:"
    echo "  tar -xvfz fop-2.6.tar.gz"
    echo
    echo "This will create the directory fop-2.6 under ~/Fop"
    echo "and unpack the fop files into it."
    echo
    echo "The path to the executive file becomes:"
    echo "  ~/Fop/fop-2.6/fop"
    echo
    echo "The final step was to add this path to the start"
    echo "of your global variable PATH"
    echo "   PATH=~/Fop/fop-2.6/fop:\$PATH"
    echo
    echo "You can do this each time you run tax-bash"
    echo "or you can add the following 2 lines to the end of ~/.bashrc"
    echo "  PATH=~/Fop/fop-2.6/fop\$PATH"
    echo "  export PATH"
    echo
    echo "Enter q to return to the previous menu."
	read choice

	case "$choice" in
	    q) break;;
	esac
    done
    

}

