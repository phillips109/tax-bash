comesFrom(){
#This function shows the navigation for this line.

#The $# is the number of parameters.     
#params=$#
#echo "$params"
#if [ $params = "3" ]; then
#    infile="../Data/$1_$2_*.xml"
#    tempfile="../Data/$1_$2_*.tmp"
#elif [ $params = "4" ]; then
    infile="../Data/$1_$2_$3_*.xml"
    tempfile="../Data/$1_$2_$3_*.tmp"
#fi
echo "infile is $infile tempfile is $tempfile"

echo "This line comes from:"
foo=$(sed -n '/<from>/s/<from>//;s/<\/from>//p' $infile)

echo $foo

for form in $foo
do	    
    echo "Do you want to show $form? Enter y or n."
    read choice
    
    if yOrn $choice
       then
       showFormLocal $form
    fi
done    

return
}    

