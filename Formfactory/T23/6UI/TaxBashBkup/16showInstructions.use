showInstructions(){
#This fuction shows the local instruction for this line.
    #The value of this line is shown as <instructions> in the data file:
#The $# is the number of parameters.     
params=$#
#echo "$params"
if [ $params = "3" ]; then
    infile="../Data/$1_Copy$2_*.xml"
    tempfile="../Data/$1_Copy$2_*.tmp"
elif [ $params = "4" ]; then
    infile="../Data/$1_Copy$2_$3_*.xml"
    tempfile="../Data/$1_Copy$2_$3_*.tmp"
fi
echo "infile is $infile. tempfile=$tempfile."
    
echo "The local instructions for this line are:"
#sed -n '/<instructions>/s/<instructions>//;s/<\/instructions>//p' $infile
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in $infile -xsl ../BaseXsl/instout.xsl   
echo

return    
}

