dependencies(){
    while true;
    do
    clear
    echo
    echo "The tax-bash program uses the following programs:"
    echo
    echo "bash    : bash is the shell in which tax-bash is written."
    echo "sed     : sed is probably already be installed by your distsribution."
    echo "awk     : awk is probably already be installed by your distribution."
    echo "m4      : m4 need to be installed."
    echo "xalan   : The java version is used (Not the C++ version) because"
    echo "          when I last checked the C++ version did not include "
    echo "          the format-number() function used extensively in tax-bash"
    echo "fop     : The apache formating engine is used."
    echo "qpdfview: This program works very well for displaying the forms."
    echo "X11     : This windowing system is needed by qpdfview."
    echo
    echo "These programs must be installed for tax-bash to work."
    echo
    echo "q)  Enter q to return to the previous menu."
    read choice
    
    case "$choice" in
	q) break;;
    esac
done

}

