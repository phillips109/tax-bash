edit_account(){

list=""
echo
echo "This function will edit the transactions for one account." 
echo "You will need to supply the name of the one account you want to edit."
echo
echo "Do you need to see a list of all available accounts?"
echo "Enter y or n."
read list

if [ "$list" = "y" ]
  then
    echo $list

    java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Work/totl.xml -xsl ../Xsl/listAccounts.xsl -out ../Work/listAccounts.xml

firefox ../Work/listAccounts.xml > /dev/null 2>&1 &
#Note: listAccounts.xml cannot be opened bye qpdfview because it is not pdf.
 #   qpdfview --unique ../Work/listAccounts.xml > /dev/null 2>&1 &
fi

echo
echo Type the name of the account you want to edit:
read account

if [ -e ../Accounts.edited/$account.xml ]; then
    emacs ../Accounts.edited/$account.xml
else
    cp ../Accounts/$account.xml ../Accounts.edited/$account.xml
    emacs ../Accounts.edited/$account.xml
fi


#When you change GnuCash and update your data, the files in
#/Accounts.edited are copied over your new data.
#In other words, when you edit and account, it becomes immutable
#until you either reedit it in /Accounts.edited or delete it
#from /Accounts.edited.

return
}

