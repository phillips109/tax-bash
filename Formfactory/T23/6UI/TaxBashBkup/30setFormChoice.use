set_form_choice() {
while true;
do
  clear
  echo "Forms :"
  echo
  echo "   1040)  U.S. Individual Income Tax Return" 
  echo "   1116)  Foreign Tax Credit"
#  echo "   2106)  Employee Business Expenses"          
#  echo "   2439)  Notice to Shareholder of Long-Term Undistributed Capital Gains"
#  echo "   2441)  Child and Dependent Care Expenses"
#  echo "   3800)  General Business Credit"
#  echo "   3903)  Moving Expenses"
#  echo "   4137)  Social Security and Medicare Tax on Unreported Tip Income"
#  echo "   4562)  Depreciation and Amortization"
#  echo "   4797)  Sales of Business Property"
  echo "   4868)  Application for Automatic Extension of Time to file"
  echo "   4952)  Investment Interest Expenses Deduction"
#  echo "   4972)  Tax on Lump-Sum Distributions"
#  echo "   5329)  Additional Taxes on Qualified Plans (inclucing IRAs) and Other Tax Favored Accounts"
#  echo "   5405)  Repayment of First-Time Homebuyer Credit"
#  echo "   5695)  Residential Energy Credits"
  echo "   6251)  Alternative Minimum Tax--Individuals"
#  echo "   6252)  Installment Sale Income"
#  echo "   8801)  Credit for Prior Year Minimum Tax--Individuals, Estates, and Trusts"
#  echo "   8812)  Child Tax Credit"
#  echo "   8814)  Parents' Election to Report Child's Interest and Dividends"
#  echo "   8815)  Exclusion of Interest from Series EE and I U.S. Savings Bonds"
#  echo "   8829)  Expenses for Business Use of Your Home"
#  echo "   8863)  Education Credits (American Opportunity and Lifetime Learning Credits)"
#  echo "   8880)  Credit for Qualified Retirement Savings Contributions"
#  echo "   8885)  Health Coverage Tax Credit"
#  echo "   8888)  Allocation of Refund (Including Savings Bond Purchases)"
#  echo "   8889)  Health Savings Accounts (HSAs)"  
#  echo "   8903)  Domestic PRoduction Activities Deduction"
#  echo "   8917)  Tuition and Fees Deduction"
#  echo "   8919)  Uncollected Social Security and Medicare Taxes on Wages"
  echo
#  echo "   8949a) Sales and Other Dispositons of Capital Assets, basis reported on Form 1099-B."
#  echo "   8949b) Sales and Other Dispositons of Capital Assets, basis not reported on Form 1099-B."
#  echo "   8949c) Sales and Other Dispositons of Capital Assets, not on Form 1099-B."
  echo
#  echo "   8959)  Additional Medicare Tax"
#  echo "   8960)  Net Investment Income Tax--Individuals, Estates, and Trusts"
#  echo "   8962)  Premium Tax Credit (PTC)"
  echo
#  echo "   1099b)    Proceeds from Broker and Barter Exchange Transactions"
  echo "   1099div)  Dividends and Distributions"
  echo "   1099int)  Interest Income"
  echo "   1099r)    Distributions from Pensions, Annuities, Retirement etc."
  echo "   1099g)    Certain Government Payments"
  echo "   1099ssa)  SSA Benefit Statemen"
  echo  
  echo "   w2)    Wage and Tax Statement"
  echo
  echo "   bkg) background"
  echo
  echo "   q)     Return to Main Menu"
  echo
  echo "Please enter the letter(s) of your choice then press return."
  read form_choice
  
    case $form_choice in

      1040)      set_copy_number  Form1040;;
      1116)      set_copy_number  Form1116;;
      2106)      set_copy_number  Form2106;;
      2439)      set_copy_number  Form2439;;
      2441)      set_copy_number  Form2441;;
      3800)      set_copy_number  Form3800;;
      3903)      set_copy_number  Form3903;;
      4137)      set_copy_number  Form4137;;
      4562)      set_copy_number  Form4562;;
      4868)      set_copy_number  Form4868;;
      4797)      set_copy_number  Form4797;;
      4952)      set_copy_number  Form4952;;
      4972)      set_copy_number  Form4972;;
      5329)      set_copy_number  Form5329;;
      5405)      set_copy_number  Form5405;;
      5695)      set_copy_number  Form5695;;
      6251)      set_copy_number  Form6251;;
      6252)      set_copy_number  Form6252;;    
      8801)      set_copy_number  Form8801;;
      8812)      set_copy_number  Form8812;;
      8814)      set_copy_number  Form8814;;
      8815)      set_copy_number  Form8815;;
      8829)      set_menu_choices Form8829;;
      8863)      set_copy_number  Form8863;;
      8880)      set_copy_number  Form8880;;
      8885)      set_copy_number  Form8885;;
      8888)      set_copy_number  Form8888;;
      8889)      set_copy_number  Form8889;;
      8903)      set_copy_number  Form8903;;
      8917)      set_copy_number  Form8917;;
      8919)      set_copy_number  Form8919;;
      8949a)     set_copy_number  Form8949a;;
      8949b)     set_copy_number  Form8949b;;
      8949c)     set_copy_number  Form8949c;;
      8959)      set_copy_number  Form8959;;
      8960)      set_copy_number  Form8960;;
      8962)      set_copy_number  Form8962;;
      1099b)     set_copy_number  Form1099b;;
      1099div)   set_copy_number  Form1099div;;
      1099int)   set_copy_number  Form1099int;;	
      1099r)     set_copy_number  Form1099r;;	
      1099g)     set_copy_number  Form1099g;;
      1099ssa)   set_copy_number  Form1099ssa;;
      w2)        set_copy_number  w2;;	
      bkg)       set_copy_number  Bkg;;      
      q)         break;;
    esac
done

}
