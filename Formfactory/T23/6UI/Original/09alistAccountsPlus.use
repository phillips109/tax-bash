
#The following is an attempt to get a list to work in a for construction.
listAccountsPlus() {
#This function displays an aphabetically sorted list of all your accounts in Firefox. 

java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Work/totl.xml -xsl ../Xsl/listAccounts.xsl -out ../Work/listAccounts.xml

sed 's/<?xml version="1.0".*?>//;s/<Accounts.*gnc">//;s/<account>//g;s/<\/account>/\n/g;s/<\/Accounts>//' ../Work/listAccounts.xml > ../Work/listAccounts.xml.tmp

#The tmp is a list with one account per line, but the names have spaces.
cat ../Work/listAccounts.xml.tmp


for account in $(cat ../Work/listAccounts.xml.tmp)
do
    echo $account > ../Work/listAccounts.xml.temp
        
done

#Note: listAccounts.xml cannot be opened by qpdfview because it is not pdf.
firefox -new-tab ../Work/listAccounts.xml.tmp > /dev/null 2>&1 &
#qpdfview  --unique ../Pdf/trnsPerForm.pdf > /dev/null 2>&1 &
return
}

