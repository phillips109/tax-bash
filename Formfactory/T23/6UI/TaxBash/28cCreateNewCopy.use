create_new_copy() {
    while true;
    do
	clear
	echo "These are the copies of "$1" that currently exist:"
	check_copy_existence $1 00
        check_copy_existence $1 01
	check_copy_existence $1 02
	check_copy_existence $1 03
	check_copy_existence $1 04
	check_copy_existence $1 05
	check_copy_existence $1 06
	check_copy_existence $1 07
	check_copy_existence $1 08
	check_copy_existence $1 09
	check_copy_existence $1 10
	check_copy_existence $1 11
	check_copy_existence $1 12
	check_copy_existence $1 13
	check_copy_existence $1 14
	check_copy_existence $1 15
	check_copy_existence $1 16
	check_copy_existence $1 17
        check_copy_existence $1 18
	check_copy_existence $1 19
	check_copy_existence $1 20
	echo
	echo "There ought to be an 00 copy."
	echo "If there is no 00 copy,"
	echo "it means this Form is not yet"
	echo "part of the tax-bash program."
	echo
	echo "The 00 copy should be kept pristine."
	echo "Choosing 00 does nothing."
	echo
	echo "Enter the number of the copy you wish to create."
        echo "This is usually the next number in the series."
	echo "01,02,03,etc. up to 20"
	echo
	echo "If you DO NOT wish to create a new copy,"
	echo "enter q to return to the previous menu."
	echo

       read copynumber

       case $copynumber in
         00) choiceNotAllowed $copynumber;;
         01) ../NewCopy/2focopy$copynumber $1
             ../NewCopy/xslcopy$copynumber $1
	     ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         02) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         03) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         04) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         05) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         06) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         07) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         08) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         09) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         10) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         11) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         12) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         13) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         14) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         15) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         16) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         17) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         18) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         19) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
         20) ../NewCopy/2focopy$copynumber $1
	     ../NewCopy/xslcopy$copynumber $1
             ../NewCopy/datacopy$copynumber $1
	     refreshTl
	     set_menu_choices $1 $copynumber;;
	 q ) break;;
	 * ) echo "Choice not recognized."
	     echo "The menu will reappear in 2 seconds."
	     sleep 2;;
	    
	esac
    done
}

