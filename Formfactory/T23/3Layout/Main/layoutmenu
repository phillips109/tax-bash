sortColumns(){
    #This removes the directions, col heading line, and blank lines:
    sed -f ../Sed/rmdir.sed ../Columns/$1.col > ../Columns/$1.col2
    #This sorts the lines by column (a-z):
    sort ../Columns/$1.col2 > ../Columns/$1.col3
    #This inserts a heading line for each column:
    awk -f ../Awk/setCols.awk ../Columns/$1.col3 > ../Columns/$1.col4
    #This line removes terminal blank space on each line.
    sed -f ../Sed/rmEndSpace.sed ../Columns/$1.col4 > ../Sorted/$1.sorted
    #These lines remove the intermediate files:
    rm ../Columns/$1.col2
    rm ../Columns/$1.col3
    rm ../Columns/$1.col4
    }

