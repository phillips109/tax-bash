    echo $1
    echo $2
    for file in $(ls ../2Fo/$1_Copy$2*.2fo)
    do
	echo $file
	foo=${file%.2fo}
	echo $foo
	foo2=${foo#../2Fo/}
	echo $foo2
	java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Output/$1_Copy$2.xml -xsl $file -out ../Fo/$foo2.fo
	fop ../Fo/$foo2.fo ../Pdf/$foo2.pdf
    done
}

