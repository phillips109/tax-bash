createDestinations(){
    while true;
    do
	echo
	echo " This menu is for creating destination files for hyperlinks."
	echo " 1) List current distination files for this form."
	echo " 2) Make a destination file for this form."
	echo " 3) List current destination files for this form."
	echo " q) Return to previous menu."
	read menu_choice

	case "$menu_choice" in
	    1) dir ../2Fo/$1_Copy$2_*.2fo;;
	    2) echo "Enter the name or number of the line you wish to make a distination."
               echo "For instance: line01 or linepnam."
               echo "The distination file will be displayed in emacs."
               echo "Using your entry as the search-string, use C-s search-string Return"
               echo "to locate the block whose background-color need to be"
               echo "changed to 'yellow'." 
               read ln
               cp ../2Fo/$1_Copy$2.2fo ../2Fo/$1_Copy$2_$ln.2fo
               emacs ../2Fo/$1_Copy$2_$ln.2fo
               makeFo $1 $2
               qpdfview ../Pdf/$1_Copy$2_$ln.pdf
	       rm ../2Fo/*~;;
             3) echo "The following files are link destination files."
                dir ../2Fo/$1_Copy$2_*.2fo;;
	     q) break;;	
		
          esac
     done	       
   }

