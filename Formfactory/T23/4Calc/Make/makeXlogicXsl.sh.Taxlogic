#!/bin/bash

#The variables have been split up into separate files in ../Variables.
#The lines have also been split up into separate files in ../Lines.
 
#This allows the developer to work on the variables and lines that relate
#to a particular form.

#Now these variable and lines  need to be reamalgamated into one file 
#in order to be valid XSL and functional code.

#This file amalgamates ../Variables/v$1_Copy$2.xsl  and ../Lines/l$1_Copy$2.xml into ../ ../Taxlogic/$1_Copy$2.tlg file. for the user to use.



rm ../Variables/*~ 2> /dev/null
rm ../Variables/?*# 2> /dev/null
rm ../Lines/*~ 2> /dev/null
rm ../Lines/?*# 2> /dev/null

 

echo '<?xml version="1.0" encoding="utf-8"?>'  > ../Taxlogic/$1_Copy$2.tlg
echo '<xsl:stylesheet version="1.0"'  >> ../Taxlogic/$1_Copy$2.tlg
echo '                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"' >> ../Taxlogic/$1_Copy$2.tlg
echo '                xmlns:fo="http://www.w3.org/1999/XSL/Format"' >> ../Taxlogic/$1_Copy$2.tlg
echo '                xmlns:xalan="http://xml.apache.org/xalan"'  >> ../Taxlogic/$1_Copy$2.tlg
echo '                exclude-result-prefixes="xalan">'  >> ../Taxlogic/$1_Copy$2.tlg

echo ''  >> ../Taxlogic/$1_Copy$2.tlg
echo '  <xsl:output indent="yes"/>'  >> ../Taxlogic/$1_Copy$2.tlg
echo ''


cat ../Variables/v$1_Copy$2.xsl >> ../Taxlogic/$1_Copy$2.tlg

#SchedC and Form8829 are mutually dependent.
#Therefore the logic file must contain logic for both forms.
#if  [ "$1" = "SchedC" ]
#then
#    cat ../Variables/vForm8829.xsl >> ../Xsl/$1_Copy$2.xsl
#fi
#if [ "$1" = "Form8829" ]
#then
#    cat ../Variables/vSchedC.xsl >> ../Xsl/$1_Copy$2.xsl
#fi

#Form1040 and SchedA are mutually dependent.
#Therefore the logic file must contain logic for both forms.

#if  [ "$1" = "Form1040" ]
#then
#    cat ../Variables/vSchedA.xsl >> ../../Xsl/$1_Copy$2.xsl
#fi
#if [ "$1" = "SchedA" ]
#then
#    cat ../Variables/vForm1040.xsl >> ../../Xsl/$1_Copy$2.xsl
#fi



echo '' >> ../Taxlogic/$1_Copy$2.tlg

echo '' >> ../Taxlogic/$1_Copy$2.tlg

echo '<xsl:template match="/">'  >> ../Taxlogic/$1_Copy$2.tlg
echo '<IRSForms>' >> ../Taxlogic/$1_Copy$2.tlg


cat ../Lines/l$1_Copy$2.xml >> ../Taxlogic/$1_Copy$2.tlg

#SchedC and Form8829 are mutually dependent.
#The logic of both are included above.
#Here the "lines" of both are included.
#if  [ "$1" = "SchedC" ]
#then
#    cat ../Lines/lForm8829.xml >> ../../Xsl/$1_Copy$2.xsl
#fi
#if [ "$1" = "Form8829" ]
#then
#    cat ../Lines/lSchedC.xml >> ../Xsl/$1_Copy$2.xsl
#fi

#Form1040 and SchedA are mutually dependent.
#The logic of both are included above.
#Here the "lines" of both are included.

#if  [ "$1" = "Form1040" ]
#then
#    cat ../Lines/lSchedA.xml >> ../Xsl/$1.xsl
#fi
#if [ "$1" = "SchedA" ]
#then
#    cat ../Lines/lForm1040.xml >> ../Xsl/$1.xsl
#fi


echo '</IRSForms>' >> ../Taxlogic/$1_Copy$2.tlg
echo '</xsl:template>' >> ../Taxlogic/$1_Copy$2.tlg
echo '</xsl:stylesheet>' >> ../Taxlogic/$1_Copy$2.tlg


#The following lines replace the text $PREVYEAR with the value of the global variable set in bashrc.
#It does it using sed rather than the shell.
#sed 's/$PREVYEAR/'"$PREVYEAR"'/' ../Taxlogic/$1_Copy$2.tlg > ../Taxlogic/$1_Copy$2.tmp
#mv ../Taxlogic/$1_Copy$2.tmp ../Taxlogic/$1_Copy$2.tlg
#rm ../Taxlogic/$1_Copy$2.tmp
exit 0
