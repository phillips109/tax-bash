<?xml version="1.0"?>
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
		version="1.0">
  <xsl:variable name="ifExists">
    <xsl:choose>
      <xsl:when test="document('../Data/Sched2_Copy01_lineTLN_text.xml')">
	<xsl:value-of select="1"/>
      </xsl:when>
      <xsl:otherwise>
	<xsl:value-of select="0"/>
      </xsl:otherwise>
    </xsl:choose>
  </xsl:variable>

  <xsl:template match="dPull">
    <File>
      <xsl:text>The value of ifExists is: </xsl:text>
      <xsl:value-of select="$ifExists"/>
    </File>
  </xsl:template>


</xsl:stylesheet>  
