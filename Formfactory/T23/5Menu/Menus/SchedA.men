set_SchedA_line_data_choice() {
while true;
do
clear
echo "Lines in SchedA in which to enter or edit data:"
echo
echo "01   )    Enter neducak abd debtak expenses. "
echo "05a  )    Enter State abd kicak ubcine taxes ir geberak sakes taxes."
echo "05b  )    Enter State and local real estate taxes."
echo "05c  )    enter State and local personal property taxes."
echo "06   )    Enter Other taxes.                 "
echo "06a  )    Enter type of other taxes.         "
echo "08   )    Enter home mortgage interes and points."
echo "08a  )    Enter home mortgage interes and points reported on Form1096."
echo "08b  )    Enter mortgage interes not reported to you on Form1098."
echo "08c  )    Enter points not reported to your on Form 1098."
echo "09   )    Investment interest.               "
echo "11   )    Enter charity gifts by cash or check."
echo "12   )    Enter charity gifts ny other than cash or check."
echo "13   )    Enter charity gifts from prior year."
echo "15   )    Enter casualty and theft losses from a federally declared disaster."
echo "16   )    Enter other itemized deductions.   "
echo "05ack)    Enter x if you elect to include gereral sales taxes."
echo "18ck )    Enter x if you elect to itemize deductions even though less than standard deduction."
echo
echo "    q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read SchedA_line_data_choice
echo
     case $SchedA_line_data_choice in
01   )    set_line_menu_number $1 $2  line01                               ;;
05a  )    set_line_menu_number $1 $2  line05a                              ;;
05b  )    set_line_menu_number $1 $2  line05b                              ;;
05c  )    set_line_menu_number $1 $2  line05c                              ;;
06   )    set_line_menu_number $1 $2  line06                               ;;
06a  )    set_line_menu_text   $1 $2  line06a                              ;;
08   )    set_line_menu_number $1 $2  line08                               ;;
08a  )    set_line_menu_number $1 $2  line08a                              ;;
08b  )    set_line_menu_number $1 $2  line08b                              ;;
08c  )    set_line_menu_number $1 $2  line08c                              ;;
09   )    set_line_menu_number $1 $2  line09                               ;;
11   )    set_line_menu_number $1 $2  line11                               ;;
12   )    set_line_menu_number $1 $2  line12                               ;;
13   )    set_line_menu_number $1 $2  line13                               ;;
15   )    set_line_menu_number $1 $2  line15                               ;;
16   )    set_line_menu_number $1 $2  line16                               ;;
05ack)    set_line_menu_text   $1 $2  line05ack                            ;;
18ck )    set_line_menu_text   $1 $2  line18ck                             ;;
q    )    break;;                       
esac
done
}
