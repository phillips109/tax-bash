set_Bkg_line_data_choice() {
while true;
do
clear
echo "Lines in Bkg in which to enter or edit data:"
echo
echo "TFNI  )    Enter taxpayor first name initial                                                                                                    "
echo "TLN   )    Enter taxpayor last name                                                                   "
echo "TSSNoF)    Enter first 3 digits of taxpayor's SS No.                                                                            "
echo "TSSNoM)    Enter middle 2 digits of taxpayor's SS No.                                                            "
echo "TSSNoL)    Enter last 4 digits of taxpayor's SS No.                                                                                "
echo "SFNI  )    Enter spouse's first name initial                                                            "
echo "SLN   )    Enter spouse's last name                                                                   "
echo "SSSNoF)    Enter first 3 digits of spouse's SS No.                                                                            "
echo "SSSNoM)    Enter middle 2 digits of spouse's SS No.                                                             "
echo "SSSNoL)    Enter last 4 digits of spouse's SS No.                                                            "
echo "FS    )    Enter filing status (S, MFJ, MFS, HOH, QSS)"
echo "Apart )    Enter time living apart (All, Some, None)                                                         "
echo
echo "     q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read Bkg_line_data_choice
echo
     case $Bkg_line_data_choice in
TFNI  )    set_line_menu_text   $1 $2  lineTFNI                             ;;
TLN   )    set_line_menu_text   $1 $2  lineTLN                              ;;
TSSNoF)    set_line_menu_text   $1 $2  lineTSSNoF                           ;;
TSSNoM)    set_line_menu_text   $1 $2  lineTSSNoM                           ;;
TSSNoL)    set_line_menu_text   $1 $2  lineTSSNoL                           ;;
SFNI  )    set_line_menu_text   $1 $2  lineSFNI                             ;;
SLN   )    set_line_menu_text   $1 $2  lineSLN                              ;;
SSSNoF)    set_line_menu_text   $1 $2  lineSSSNoF                           ;;
SSSNoM)    set_line_menu_text   $1 $2  lineSSSNoM                           ;;
SSSNoL)    set_line_menu_text   $1 $2  lineSSSNoL                           ;;
FS    )    set_line_menu_text   $1 $2  lineFS                               ;;
Apart )    set_line_menu_text   $1 $2  lineApart                            ;;
q     )    break;;                       
esac
done
}
