set_UG1250Wkst_line_data_choice() {
while true;
do
clear
echo "Lines in UG1250Wkst in which to enter or edit data:"
echo
echo "01)    Enter data per instructions.       "
echo "02)    Enter data per instructions.       "
echo "04)    Enter data per instructions.       "
echo "05)    Enter data per instructions.       "
echo "08)    Enter data per instructions.       "
echo "10)    Enter data per instructions.       "
echo "11)    Enter data per instructions.       "
echo "12)    Enter data per instructions.       "
echo "14)    Enter data per instructions.       "
echo "15)    Enter data per instructions.       "
echo "16a)   Enter data per instructions for line 16..       "
echo
echo " q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read UG1250Wkst_line_data_choice
echo
     case $UG1250Wkst_line_data_choice in
01)    set_line_menu_number $1 $2  line01                               ;;
02)    set_line_menu_number $1 $2  line02                               ;;
04)    set_line_menu_number $1 $2  line04                               ;;
05)    set_line_menu_number $1 $2  line05                               ;;
08)    set_line_menu_number $1 $2  line08                               ;;
10)    set_line_menu_number $1 $2  line10                               ;;
11)    set_line_menu_number $1 $2  line11                               ;;
12)    set_line_menu_number $1 $2  line12                               ;;
14)    set_line_menu_number $1 $2  line14                               ;;
15)    set_line_menu_number $1 $2  line15                               ;;
16a)   set_line_menu_number $1 $2  line16a                               ;;
q )    break;;                       
esac
done
}
