set_SchedC_line_data_choice() {
while true;
do
clear
echo "Lines in SchedC in which to enter or edit data:"
echo
echo "PrBus )    Enter the principal business or profession engaged in. 
echo "B1    )    Enter the first code number.                                                                  "
echo "B2    )    Enter the second code number.                                                                 "
echo "B3    )    Enter the third code number.                                                                  "
echo "B4    )    Enter the fourth code number.                                                                 "
echo "B5    )    Enter the fifth code number.                                                                  "
echo "B6    )    Enter the sixth code number.                                                                  "
echo "BusNm )    Enter the business name if separate from line A.                                              "
echo "D1    )    Enter the first code number.                                                                  "
echo "D2    )    Enter the second code number.                                                                 "
echo "D3    )    Enter the third code number.                                                                  "
echo "D4    )    Enter the fourth code number.                                                                 "
echo "D5    )    Enter the fifth code number.                                                                  "
echo "D6    )    Enter the sixth code number.                                                                  "
echo "D7    )    Enter the seventh code number.                                                                "
echo "D8    )    Enter the eighth code number.                                                                 "
echo "D9    )    Enter the ninth code number.                                                                  "
echo "Addr1 )    Enter the first address line of the business.                                                 "
echo "Addr2 )    Enter the second address line of the business.                                                "
echo "City  )    Enter the ciy in which the business is located.                                               "
echo "ST    )    Enter the state (ST) in which the buseiness is located.                                       "
echo "zip   )    Enter the zip code of the business.                                                           "
echo "cash  )    Enter x if the accounting method is cash based.                                               "
echo "accru )    Enter x if the accounting method is accrual based.                                            "
echo "other )    Enter x if an other accounting method was used.                                               "
echo "specif)    Specify the accounting method used.                                                           "
echo "Gy    )    Emter x if you "materially participated" in the operation of the business during 2023.        "
echo "Gn    )    Enter x if you did not "materially participate" in the operation of the business during 2023. "
echo "Hx    )    Enter x if you started or acquired this business during 2023.                                 "
echo "Iy    )    Enter x if you made any payments in 2023 that would require filing Form(s) 1099.              "
echo "In    )    Enter x if you did not make any payments in 2023 thot would require filing Form(s) 1099.      "
echo "Jy    )    Enter x if you did or will file any required Form(s) 1099.                                    "
echo "Jn    )    Enter x if you did not and will not file any required Form(s) 1099.                           "
echo "01Ck  )    Enter x if income on line01 was reported to you on FormW2 and "Statutory employee was checked."
echo "01    )    Enter gross receipts or sales.                                                                "
echo "02    )    Enter returns anad allowances.                                                                "
echo "04    )    Enter dost of goods sold from line 42.                                                        "
echo "06    )    Enter other income.                                                                           "
echo "08    )    Enter advertising expenses.                                                                   "
echo "09    )    Enter car and truck expenses.                                                                 "
echo "10    )    Enter commission and fee expenses.                                                            "
echo "11    )    Enter contract labor expenses.                                                                "
echo "12    )    Enter depletion expenses.                                                                     "
echo "13    )    Enter depreciation and section 179 expenses.                                                  "
echo "14    )    Enter e,ployee benefit program expenses.                                                      "
echo "15    )    Enter insurance (other than heallth) expenses.                                                "
echo "16a   )    Enter mortage interest expenses.                                                              "
echo "16b   )    Enter other interest expenses.                                                                "
echo "17    )    Enter legal and professional services expenses.                                               "
echo "18    )    Enter office expenses.                                                                        "
echo "19    )    Enter pension and profit-sharing plan expenses.                                               "
echo "20a   )    Enter rent or lease expenses for vehicles, machinery and equipment.                           "
echo "20b   )    Enter rent or lease expenses for other business property.                                     "
echo "21    )    Enter repair and maintenance expenses.                                                        "
echo "22    )    Enter expenses for supplies.                                                                  "
echo "23    )    Enter tax and license expenses.                                                               "
echo "24a   )    Enter travel expenses.                                                                        "
echo "24b   )    Enter meal deductions.                                                                        "
echo "25    )    Enter utility expenses.                                                                       "
echo "26    )    Enter wage expenses (less employment credits).                                                "
echo "27a   )    Enter other expenses from line 48.                                                            "
echo "27b   )    Enter deduction for energy efficient commercial buildings.(Form 7205)                         "
echo "30    )    Enter expenses for the business use of your home. (Form 8829)                                 "
echo "30a   )    For simplified method: Enter total square footage of your home.                               "
echo "30b   )    For simplified method: Enter ssquare footage used for business.                               "
echo "32a   )    Enter x if all investment is at risk.                                                         "
echo "32b   )    Enter x if some of the investment is not at risk.                                             "
echo "33a   )    Enter x if the method used to value closing inventory was "cash".                             "
echo "33b   )    Enter x if the method used to value closing inventory was "lower of cost or market".          "
echo "33c   )    Enter s if another method was used to value closing inventory.                                "
echo "34y   )    Enter x if there was any change in determininig quantities, costs, or valualtions             "
echo "34n   )    Enter x if there was not any such change.                                                     "
echo "35    )    Enter value of inventory at the beginning of the year.                                        "
echo "36    )    Enter cost of purchases less cost of items withdrawn for personal use.                        "
echo "37    )    Enter cost of labor.                                                                          "
echo "38    )    Enter cost of materials and supplies.                                                         "
echo "39    )    Enter other costs.                                                                            "
echo "41    )    Enter value of inventory at the end of the year.                                              "
echo "43d   )    Enter the day (dd) your vehicle was placed in service for business purposes.                  "
echo "43m   )    Enter the month (mm) your vehicle was placed in service for business purposes.                "
echo "43y   )    Enter the year (yyyy) your vehicle was placed in service for business purposes.               "
echo "44a   )    Enter the number of miles you drove your vehicle for business during 2023.                    "
echo "44b   )    Enter the number of miles you drove your vehicle for commuting during 2023.                   "
echo "44c   )    Enter the number of miles you drove your vehicle for other purposes during 2023.              "
echo "45y   )    Enter x if your vehicle was available for personal use during off-duty hours.                 "
echo "45n   )    Enter x if your vehicle was not available for personal use during off-duty hours.             "
echo "46y   )    Enter x if you or your spouse have anothe vehicle available for personal use.                 "
echo "46n   )    Enter x if you or your spouse do not have anothe vehicle availabel for personal use.          "
echo "47ay  )    Enter x if you have evidence to support your deduction.                                       "
echo "47an  )    Enter x if you do not have evidence to support your deduction.                                "
echo "47bn  )    Enter x if your evidence is written.                                                          "
echo "47by  )    Enter x if your evidence is not written.                                                      "
echo "Exp1nm)    Enter the name of the first business expense catagory.                                        "
echo "Exp1  )    Enter the amount expensedvfor the first expense catagory.                                     "
echo "Exp2nm)    Enter the name of the second business expensecatagory.                                        "
echo "Exp2  )    Enter the amount expensed for the second expense catagory                                     "
echo "Exp3nm)    Enter the name of the thiird business expense catagory.                                       "
echo "Exp3  )    Enter the amount expensed for the third expense catagory.                                     "
echo "Exp4nm)    Enter the name of the fourth business expense catagory.                                       "
echo "Exp4  )    Enter the amount expensed for the fourth expense catagory.                                    "
echo "Exp5nm)    Enter the name of the fifth business expense catagory.                                        "
echo "Exp5  )    Enter the amount expensed for the fifth expense catagory.                                     "
echo "Exp6nm)    Enter the name of the sixth business expense catagory.                                        "
echo "Exp6  )    Enter the amount expensed for the sixthe expense catagory.                                    "
echo "Exp7nm)    Enter the name of the seventh business expense catagory.                                      "
echo "Exp7  )    Enter the amount expensed for the seventh expense catagory.                                   "
echo "Exp8nm)    Enter the name of the eighth business expense catagory.                                       "
echo "Exp8  )    Enter the amount expensed for the eight expense catagory.                                     "
echo "Exp9nm)    Enter the name of the ninth business expense catagory.                                        "
echo "Exp9  )    Enter the amount expensed for the ninthe expenses catagory.                                   "
echo
echo "     q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read SchedC_line_data_choice
echo
     case $SchedC_line_data_choice in
PrBus )    set_line_menu_text   $1 $2  linePrBus                          14;;
B1    )    set_line_menu_text   $1 $2  lineB1                             14;;
