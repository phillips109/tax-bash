set_Form1099int_line_data_choice() {
while true;
do
clear
echo "Lines in Form1099int in which to enter or edit data:"
echo
echo "void )    Enter x if form is void.           "
echo "corr )    Enter x if Form has been corrected."
echo "pnam1)    Enter line 1 of payor's name.      "
echo "pnam2)    Enter line 2 of payor's name.      "
echo "padd1)    Enter line 1 of payor's address.   "
echo "padd2)    Enter line 2 of payor's address.   "
echo "pcity)    Enter payor's city.                "
echo "pST  )    Enter payor's state.               "
echo "pcnty)    Enter payor's county.              "
echo "pctry)    Enter payor's country.             "
echo "pzip )    Enter payor's zip.                 "
echo "ptel )    Enter payor's telephone number.    "
echo "pTIN )    Enter payor's TIN.                 "
echo "rTIN )    Enter recipient's TIN.             "
echo "rnam1)    Enter line 1 of recipient's name.  "
echo "rnam2)    Enter line 2 of recipient's name.  "
echo "radd1)    Enter line 1 of recipient's address."
echo "radd2)    Enter line 2 of recipient's address."
echo "rcity)    Enter recipient's city.            "
echo "rST  )    Enter recipient's state.           "
echo "rcnty)    Enter recipient's county.          "
echo "rctry)    Enter recipient's country.         "
echo "rzip )    Enter recipient's zip.             "
echo "FATCA)    Enter x if FATCA filing required.  "
echo "actNo)    Enter account number.              "
echo "2TIN )    Enter x if 2nd TIN.                "
echo "pRTN )    Enter recipient's RTN (optional).  "
echo "20yr )    Enter last 2 digits of filing year."
echo "01   )    Enter interest income.             "
echo "02   )    Enter early withdrawal penalty.    "
echo "03   )    Enter interest on US Savings Bonds and Treasury obligations."
echo "04   )    Enter federal income tax withheld. "
echo "05   )    Enter investment expenses.         "
echo "06   )    Enter foreign tax paid.            "
echo "07   )    Enter the foreign country or US possession."
echo "08   )    Enter tax-exempt interest.         "
echo "09   )    Enter specified private activity bond interest."
echo "10   )    Enter market discount.             "
echo "11   )    Enter bond premium.                "
echo "12   )    Enter bond premium on Treasury obligations."
echo "13   )    Enter Bond premium on tax-exempt bond."
echo "14   )    Enter tax-exempt and tax credit bond CUSIP number."
echo "15a  )    Enter first state where tax was withheld."
echo "16a  )    Enter ID number of first state.    "
echo "17a  )    Enter tax withheld by first state. "
echo "15b  )    Enter second state wher tax was withheld."
echo "16b  )    Enter ID number of second state.   "
echo "17b  )    Enter tax withheld by second state."
echo
echo "    q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read Form1099int_line_data_choice
echo
     case $Form1099int_line_data_choice in
void )    set_line_menu_text   $1 $2  linevoid                             ;;
corr )    set_line_menu_text   $1 $2  linecorr                             ;;
pnam1)    set_line_menu_text   $1 $2  linepnam1                            ;;
pnam2)    set_line_menu_text   $1 $2  linepnam2                            ;;
padd1)    set_line_menu_text   $1 $2  linepadd1                            ;;
padd2)    set_line_menu_text   $1 $2  linepadd2                            ;;
pcity)    set_line_menu_text   $1 $2  linepcity                            ;;
pST  )    set_line_menu_text   $1 $2  linepST                              ;;
pcnty)    set_line_menu_text   $1 $2  linepcnty                            ;;
pctry)    set_line_menu_text   $1 $2  linepctry                            ;;
pzip )    set_line_menu_text   $1 $2  linepzip                             ;;
ptel )    set_line_menu_text   $1 $2  lineptel                             ;;
pTIN )    set_line_menu_text   $1 $2  linepTIN                             ;;
rTIN )    set_line_menu_text   $1 $2  linerTIN                             ;;
rnam1)    set_line_menu_text   $1 $2  linernam1                            ;;
rnam2)    set_line_menu_text   $1 $2  linernam2                            ;;
radd1)    set_line_menu_text   $1 $2  lineradd1                            ;;
radd2)    set_line_menu_text   $1 $2  lineradd2                            ;;
rcity)    set_line_menu_text   $1 $2  linercity                            ;;
rST  )    set_line_menu_text   $1 $2  linerST                              ;;
rcnty)    set_line_menu_text   $1 $2  linercnty                            ;;
rctry)    set_line_menu_text   $1 $2  linerctry                            ;;
rzip )    set_line_menu_text   $1 $2  linerzip                             ;;
FATCA)    set_line_menu_text   $1 $2  lineFATCA                            ;;
actNo)    set_line_menu_text   $1 $2  lineactNo                            ;;
2TIN )    set_line_menu_text   $1 $2  line2TIN                             ;;
pRTN )    set_line_menu_text   $1 $2  linepRTN                             ;;
20yr )    set_line_menu_text   $1 $2  line20yr                             ;;
01   )    set_line_menu_number $1 $2  line01                               ;;
02   )    set_line_menu_number $1 $2  line02                               ;;
03   )    set_line_menu_number $1 $2  line03                               ;;
04   )    set_line_menu_number $1 $2  line04                               ;;
05   )    set_line_menu_number $1 $2  line05                               ;;
06   )    set_line_menu_number $1 $2  line06                               ;;
07   )    set_line_menu_text   $1 $2  line07                               ;;
08   )    set_line_menu_number $1 $2  line08                               ;;
09   )    set_line_menu_number $1 $2  line09                               ;;
10   )    set_line_menu_number $1 $2  line10                               ;;
11   )    set_line_menu_number $1 $2  line11                               ;;
12   )    set_line_menu_number $1 $2  line12                               ;;
13   )    set_line_menu_number $1 $2  line13                               ;;
14   )    set_line_menu_number $1 $2  line14                               ;;
15a  )    set_line_menu_text   $1 $2  line15a                              ;;
16a  )    set_line_menu_text   $1 $2  line16a                              ;;
17a  )    set_line_menu_number $1 $2  line17a                              ;;
15b  )    set_line_menu_text   $1 $2  line15b                              ;;
16b  )    set_line_menu_text   $1 $2  line16b                              ;;
17b  )    set_line_menu_number $1 $2  line17b                              ;;
q    )    break;;                       
esac
done
}
