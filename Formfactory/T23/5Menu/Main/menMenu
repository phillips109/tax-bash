showJpg(){
    dir ../../1Pdf2Jpg/Jpg
    echo "Enter the file that you wish displayed."
    read file
    qpdfview ../../1Pdf2Jpg/Jpg/$file &
    }

importText(){
	if [ -f ../../4Calc/Sort/$1.srt ]
	   then
		cp ../../4Calc/Sort/$1.srt ../Txt/$1.txt
	elif [ -f ../../2Sequence/Txt/$1.txt ]
	     then
		cp ../../2Sequence/Txt/$1.txt ../Txt/$1.txt
	else
		echo "../../2Sequence/Txt/$1.txt doesn't exist."
		echo "Cannot proceed."
	
	fi	
}

editText(){
    emacs ../Txt/$1.txt
}


showEntriesOnly(){

      awk -f ../Awk/showEntriesOnly3.awk form="$1" ../Txt/$1.txt | sort > ../Entries/$1.ent
#      awk -f ../Awk/reorderColumns.awk ../Entries/$1.ent > ../Pre/$1.pre
      
#     awk -f ../Awk/showEntriesOnly2.awk form="$1" ../Entries/$1.txt | sort > ../Entries/$1.ent
#    awk -f ../Awk/showEntriesOnly.awk form="$1" ../Txt/$1.txt | sort > ../Entries/$1.ent


}
editEntries(){
    emacs ../Entries/$1.ent
}

reorderColumns(){

	awk -f ../Awk/reorderColumns.awk form=$1 ../Entries/$1.ent > ../Pre/$1.pre
}

editPre(){

	emacs ../Pre/$1.pre
}

rmEndSpacePre(){
    sed -f ../Sed/rmEndSpace.sed ../Pre/$1.pre > $1.pre.tmp
    cp $1.pre.tmp ../Pre/$1.pre
    rm $1.pre.tmp
}

rmEmacsBkups(){
    rm ../Txt/*~	
}


