makeMenuFile(){
    awk -f ../Awk/menu2.awk -f ../Awk/sortd.awk "form=$1" ../Pre/$1.pre > ../Menus/$1.men
    }

editMenu(){
    emacs ../Menus/$1.men
}
    
catMenus(){
#This combines all menu files into one ../Files/all
    rm ../Files/*
#    rm ../Menus/*~
    cat ../Menus/*.men > ../Files/allMenus
    }

addColumns(){

	awk -f ../Awk/addColumns.awk "form=$1" ../Pre/$1.pre   > $1.pre2.tmp
	cp $1.pre2.tmp ../Pre2/$1.pre2
	rm $1.pre2.tmp
}


editPre2(){
	emacs ../Pre2/$1.pre2
}

backUpPre2(){

	cp ../Pre2/$1.pre2 ../BkupPre2/$1.pre2
}

convertEnt2xml(){
	awk -f ../Awk/convertEnt2xml.awk -v form=$1 ../Pre2/$1.pre2 > ../Xml/$1.xml
}

editXml(){
	emacs ../Xml/$1.xml
}

createData(){
    rm ../Data/$1*.xml
#    awk -f ../Awk/txt4xml.awk form=$1 ../Txt/$1.txt > ../Templates/$1.tpl
    java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Xml/$1.xml -xsl ../Make/makeDataFile.xsl -out ../Out/$1_Copy00.xml -PARAM form $1
    }

exportData(){
    rm ../../7App/Data/$1*.xml
    for file in $(ls ../Data/$1*)
    do
	cp $file ../../7App/Data/
    done
}

set_menu_choices(){
    while true;
    do
#	clear
	echo
	echo " This menu is to produce a menu for the entry of data."
	echo " It also produces the data files in which the data is stored."
	echo
	echo "  1) Show image of the form"
	echo "  2) Import text from ../4Calc or else ../2Sequence"
	echo "  3) Edit ../Text/$1.txt to remove title line"
	echo "  4) Remove all but user entry lines from ../Txt/$1.txt"
	echo "  5) Check ../Entries/$1.ent to enter menuEntries"
	echo "  6) Reorder columns to ../Pre/$1.pre"
	echo "  7) Edit ../Pre/$1.pre"
	echo "  8) Remove endspace from ../Pre/$1.pre"
	echo "  9) Make ../Menus/$1.men"
	echo " 10) Edit ../Menus/$1.men to check result."
	echo " 11) Combine all menus into ../Files/allMenus"
	echo " 12) Add IRSInstructions ../Pre/$1.pre to ../Pre2/$1.pre2"
	echo " 13) Edit ../Pre2/$1.pre2 to enter pgNo"
	echo " 14) Backup ../Pre2/$1.pre2 to ../BkupPre2/$1.pre2"
	echo " 15) Convert .ent2 to xml"
	echo " 16) Edit ../Xml/$1.xml"
	echo " 17) Make data files"
	echo " 18) Export data files to ../../7App/Data"
	echo
	echo "  q) Quit"
	echo
	echo "  Please enter the number or letter(s) of your choice then press return."

	read menu_choice

	case "$menu_choice" in

	    1)  choosePdf $1;; 
	    2)  importText $1;;
	    3)  editText $1;;
	    4)  showEntriesOnly $1;;
	    5)  editEntries $1;;
	    6)  reorderColumns $1;;
	    7)  editPre $1;;
	    8)  rmEndSpacePre $1;;
	    9)  makeMenuFile $1;;
	   10)  editMenu $1;;
	   11)  catMenus $1;;
	   12)  addColumns $1;;
	   13)  editPre2 $1;;
	   14)  backUpPre2 $1;; 
	   15)  convertEnt2xml $1;;
	   16)  editXml $1;; 
	   17)  createData $1;;	     
	   18)  exportData $1;;

	    q)  exit;;
	    *)  echo "Sorry, choice not recognized."

	esac

   done	
	    
    }



