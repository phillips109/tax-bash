set_SchedDTaxWkst_line_data_choice() {
while true;
do
clear
echo "Lines in SchedDTaxWkst in which to enter or edit data:"
echo
echo
echo "q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read SchedDTaxWkst_line_data_choice
echo
     case $SchedDTaxWkst_line_data_choice in
q)    break;;                       
esac
done
}
