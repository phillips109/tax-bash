set_CapLossCarryWks_line_data_choice() {
while true;
do
clear
echo "Lines in CapLossCarryWks in which to enter or edit data:"
echo
echo
echo "q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read CapLossCarryWks_line_data_choice
echo
     case $CapLossCarryWks_line_data_choice in
q)    break;;                       
esac
done
}
