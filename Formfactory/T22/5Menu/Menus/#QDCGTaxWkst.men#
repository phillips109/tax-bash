qset_QDCGTaxWkst_line_data_choice() {
while true;
do
clear
echo "Lines in QDCGTaxWkst in which to enter or edit data:"
echo
echo "03y)    x                                  "
echo "03n)                                       "
echo
echo "  q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read QDCGTaxWkst_line_data_choice
echo
     case $QDCGTaxWkst_line_data_choice in
03y)    set_line_menu_text   $1 $2  line03y                            14;;
03n)    set_line_menu_text   $1 $2  line03n                            14;;
q  )    break;;                       
esac
done
}
