set_Sched3_line_data_choice() {
while true;
do
clear
echo "Lines in Sched3 in which to enter or edit data:"
echo
echo "TFNI  )    Enter Taxpayor first name initial. "
echo "TLN   )    Enter taxpayor last name.                              "
echo "TSSNoF)    Enter taxpayor SS No. part 1.                          "
echo "TSSNoM)    Enter taxpayor SS No. part 2.                         "
echo "TSSNoL)    Enter taxpayor SS No. part 3.      "
echo "zline1)    Enter text for 06z line01.         "
echo "zline2)    Enter text for 06z line01.         "
echo "06z   )    Enter other nonrefundable credits.                     "
echo "09    )    Enter net premium tax credit.                          "
echo "10    )    Enter amount paid with request for extension to file.  "
echo "11    )    Enter social security and tier 1 PRTA tax withheld.    "
echo "12    )    Enter credit for federal tax on fuels.                "
echo "13a   )    Form 2439                              "
echo "13b   )    Credit for qualified sick and family leave wages      "
echo "13d   )    Credit for repayment of amts included in income from earlier years.           "
echo "13f   )    Deferred amt of net 966 tax liability.                 "
echo "13h   )    Credit for qualified sisck and famil leave wagees      "
echo "13z   )    other payments or refundable credits.                              "
echo
echo "     q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read Sched3_line_data_choice
echo
     case $Sched3_line_data_choice in
TFNI  )    set_line_menu_text   $1 $2  lineTFNI                           14;;
TLN   )    set_line_menu_text   $1 $2  lineTLN                            14;;
TSSNoF)    set_line_menu_text   $1 $2  lineTSSNoF                         14;;
TSSNoM)    set_line_menu_text   $1 $2  lineTSSNoM                         14;;
TSSNoL)    set_line_menu_text   $1 $2  lineTSSNoL                         14;;
zline1)    set_line_menu_text   $1 $2  linezline1                         14;;
zline2)    set_line_menu_text   $1 $2  linezline2                         14;;
06z   )    set_line_menu_number $1 $2  line06z                            14;;
09    )    set_line_menu_number $1 $2  line09                             14;;
10    )    set_line_menu_number $1 $2  line10                             14;;
11    )    set_line_menu_number $1 $2  line11                             14;;
12    )    set_line_menu_number $1 $2  line12                             14;;
13a   )    set_line_menu_number $1 $2  line13a                            14;;
13b   )    set_line_menu_number $1 $2  line13b                            14;;
13d   )    set_line_menu_number $1 $2  line13d                            14;;
13f   )    set_line_menu_number $1 $2  line13f                            14;;
13h   )    set_line_menu_number $1 $2  line13h                            14;;
13z   )    set_line_menu_number $1 $2  line13z                            14;;
q     )    break;;                       
esac
done
}
