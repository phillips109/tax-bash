set_Form4952_line_data_choice() {
while true;
do
clear
echo "Lines in Form4952 in which to enter or edit data:"
echo
echo "01 )    Enter investment interest expense paid or accrues in 2022            "
echo "04a)    Enter gross income from property held for investment                        "
echo "04b)    Enter qualified dividents included on line 4a                              "
echo "04d)    Enter net gain from dispositon of propert held for investment               "
echo "04g)    Enter the amount from lines 4b or yournet capital gain from the disposition of property held for investsment                              "
echo "05 )    Enter investment expenses                              "
echo
echo "  q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read Form4952_line_data_choice
echo
     case $Form4952_line_data_choice in
01 )    set_line_menu_number $1 $2  line01                             14;;
04a)    set_line_menu_number $1 $2  line04a                            14;;
04b)    set_line_menu_number $1 $2  line04b                            14;;
04d)    set_line_menu_number $1 $2  line04d                            14;;
04g)    set_line_menu_number $1 $2  line04g                            14;;
05 )    set_line_menu_number $1 $2  line05                             14;;
q  )    break;;                       
esac
done
}
