8set_SchedDTaxWkst_line_data_choice() {
while true;
do
clear
echo "Lines in SchedDTaxWkst in which to enter or edit data:"
echo
echo "215)    Enter the constant 0.15            "
echo "125)    Enter the constant 0.25            "
echo
echo "  q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read SchedDTaxWkst_line_data_choice
echo
     case $SchedDTaxWkst_line_data_choice in
215)    set_line_menu_number $1 $2  line215                            14;;
125)    set_line_menu_number $1 $2  line125                            14;;
q  )    break;;                       
esac
done
}
