set_Form1099div_line_data_choice() {
while true;
do
clear
echo "Lines in Form1099div in which to enter or edit data:"
echo
echo "void  )    Enter x if form is void.           "
echo "corr  )    Enter x if form has been corrected."
echo "pnam1 )    Emter payor's name line1.          "
echo "pnam2 )    Enter payor's name line2.          "
echo "padd1 )    Enter line1 of payor's address.    "
echo "padd2 )    Enter line2 of payor's address.    "
echo "pcity )    Enter payor's city.                "
echo "pST   )    Emter payor's state.               "
echo "pctry )    Enter payor's country.             "
echo "pzip  )    Enter payor's zip.                 "
echo "ptel  )    Emter payor's telephone number.    "
echo "pTIN  )    Enter payor's TIN.                 "
echo "rTIN  )    Enter recipient's TIN.             "
echo "rname1)    Enter recipient's name line1.      "
echo "rname2)    Enter recipient's name line2.      "
echo "raddr1)    Enter line1 of recipient's address,"
echo "raddr2)    Enter line2 of recipient's addresss,"
echo "rcity )    Enter recipient's city.            "
echo "rST   )    Emter recipient's state.           "
echo "rctry )    Enter recipient's country.         "
echo "rzip  )    Enter recipient's zip.             "
echo "FATCA )    Enter x if FATCA is required.      "
echo "actNo )    Enter accounts number.             "
echo "2TIN  )    Enter x if second TIN.             "
echo "01a   )    Enter total ordinary dividends.    "
echo "01b   )    Enter qualified dividends.         "
echo "20yr  )    Enter last two digits of year of report."
echo "02a   )    Enter total capital gain distribution."
echo "02b   )    Enter unrecaptured Sec. 1250 gain. "
echo "02c   )    Enter Sec. 1250 gain.              "
echo "02d   )    Enter collectibles (28%) gain.     "
echo "02e   )    Enter Section 897 ordinary dividends."
echo "02f   )    Enter Section 897 capital gain.    "
echo "03    )    Enter nondividend distributions.   "
echo "04    )    Enter federal income tax withheld. "
echo "05    )    Enter Section 199A dividends.      "
echo "06    )    Enter Investment expenses.         "
echo "07    )    Enter foreign tax paid.            "
echo "08    )    Enter foreign country or US possession."
echo "09    )    Enter cash liquidation distributions."
echo "10    )    Enter noncash liquidation distrivutions."
echo "12    )    Enter exempt-interest dividends.   "
echo "13    )    Enter specified private activity bond interest dividends."
echo "14a   )    Enter first state with tax withheld."
echo "15a   )    Enter first state's ID number.     "
echo "16a   )    Enter tax withheld by first state. "
echo "14b   )    Enter second state with tax withheld."
echo "15b   )    Enter second state's ID number.    "
echo "16b   )    Enter tax withheld by second state."
echo
echo "     q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read Form1099div_line_data_choice
echo
     case $Form1099div_line_data_choice in
void  )    set_line_menu_text   $1 $2  linevoid                           14;;
corr  )    set_line_menu_text   $1 $2  linecorr                           14;;
pnam1 )    set_line_menu_text   $1 $2  linepnam1                          14;;
pnam2 )    set_line_menu_text   $1 $2  linepnam2                          14;;
padd1 )    set_line_menu_text   $1 $2  linepadd1                          14;;
padd2 )    set_line_menu_text   $1 $2  linepadd2                          14;;
pcity )    set_line_menu_text   $1 $2  linepcity                          14;;
pST   )    set_line_menu_text   $1 $2  linepST                            14;;
pctry )    set_line_menu_text   $1 $2  linepctry                          14;;
pzip  )    set_line_menu_text   $1 $2  linepzip                           14;;
ptel  )    set_line_menu_text   $1 $2  lineptel                           14;;
pTIN  )    set_line_menu_text   $1 $2  linepTIN                           14;;
rTIN  )    set_line_menu_text   $1 $2  linerTIN                           14;;
rname1)    set_line_menu_text   $1 $2  linername1                         14;;
rname2)    set_line_menu_text   $1 $2  linername2                         14;;
raddr1)    set_line_menu_text   $1 $2  lineraddr1                         14;;
raddr2)    set_line_menu_text   $1 $2  lineraddr2                         14;;
rcity )    set_line_menu_text   $1 $2  linercity                          14;;
rST   )    set_line_menu_text   $1 $2  linerST                            14;;
rctry )    set_line_menu_text   $1 $2  linerctry                          14;;
rzip  )    set_line_menu_text   $1 $2  linerzip                           14;;
FATCA )    set_line_menu_text   $1 $2  lineFATCA                          14;;
actNo )    set_line_menu_text   $1 $2  lineactNo                          14;;
2TIN  )    set_line_menu_text   $1 $2  line2TIN                           14;;
01a   )    set_line_menu_number $1 $2  line01a                            14;;
01b   )    set_line_menu_number $1 $2  line01b                            14;;
20yr  )    set_line_menu_text   $1 $2  line20yr                           14;;
02a   )    set_line_menu_number $1 $2  line02a                            14;;
02b   )    set_line_menu_number $1 $2  line02b                            14;;
02c   )    set_line_menu_number $1 $2  line02c                            14;;
02d   )    set_line_menu_number $1 $2  line02d                            14;;
02e   )    set_line_menu_number $1 $2  line02e                            14;;
02f   )    set_line_menu_number $1 $2  line02f                            14;;
03    )    set_line_menu_number $1 $2  line03                             14;;
04    )    set_line_menu_number $1 $2  line04                             14;;
05    )    set_line_menu_number $1 $2  line05                             14;;
06    )    set_line_menu_number $1 $2  line06                             14;;
07    )    set_line_menu_number $1 $2  line07                             14;;
08    )    set_line_menu_text   $1 $2  line08                             14;;
09    )    set_line_menu_number $1 $2  line09                             14;;
10    )    set_line_menu_number $1 $2  line10                             14;;
12    )    set_line_menu_number $1 $2  line12                             14;;
13    )    set_line_menu_text   $1 $2  line13                             14;;
14a   )    set_line_menu_text   $1 $2  line14a                            14;;
15a   )    set_line_menu_text   $1 $2  line15a                            14;;
16a   )    set_line_menu_number $1 $2  line16a                            14;;
14b   )    set_line_menu_text   $1 $2  line14b                            14;;
15b   )    set_line_menu_text   $1 $2  line15b                            14;;
16b   )    set_line_menu_number $1 $2  line16b                            14;;
q     )    break;;                       
esac
done
}
