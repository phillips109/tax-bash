set_Bkg_line_data_choice() {
while true;
do
clear
echo "Lines in Bkg in which to enter or edit data:"
echo
echo "TFNI  )    Enter taxpayor's first name and initial."
echo "TLN   )    Enter taxpayor's last name.        "
echo "TSSNoF)    Enter first three digits of taxpayor's SS Number.  "
echo "TSSNoM)    Enter 4th and 5th digits of taxpayor's SS Number."
echo "TSSNoL)    Enter lasts four digits of taxpayor's SS Number. "
echo "SFNI  )    Enter spouse's first name and initial.                              "
echo "SLN   )    Enter spouse's last name.          "
echo "SSSNoF)    Enter first three digits of taxpayor's SS Number."
echo "SSSNoM)    Enter 4th and 5th digits of taxpayor's SS Number."
echo "SSSNoL)    Enter lasts four digits of taxpayor's SS Number."
echo "FS    )    Enter filing status: S, MFJ, MFS, HOH, QSS.                              "
echo "Apart )    If MFS, enter part of year apart: None, Some, All.                              "
echo
echo "     q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read Bkg_line_data_choice
echo
     case $Bkg_line_data_choice in
TFNI  )    set_line_menu_text   $1 $2  lineTFNI                           14;;
TLN   )    set_line_menu_text   $1 $2  lineTLN                            14;;
TSSNoF)    set_line_menu_text   $1 $2  lineTSSNoF                         14;;
TSSNoM)    set_line_menu_text   $1 $2  lineTSSNoM                         14;;
TSSNoL)    set_line_menu_text   $1 $2  lineTSSNoL                         14;;
SFNI  )    set_line_menu_text   $1 $2  lineSFNI                           14;;
SLN   )    set_line_menu_text   $1 $2  lineSLN                            14;;
SSSNoF)    set_line_menu_text   $1 $2  lineSSSNoF                         14;;
SSSNoM)    set_line_menu_text   $1 $2  lineSSSNoM                         14;;
SSSNoL)    set_line_menu_text   $1 $2  lineSSSNoL                         14;;
FS    )    set_line_menu_text   $1 $2  lineFS                             14;;
Apart )    set_line_menu_text   $1 $2  lineApart                          14;;
q     )    break;;                       
esac
done
}
