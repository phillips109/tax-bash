set_SSA_1099_line_data_choice() {
while true;
do
clear
echo "Lines in SSA_1099 in which to enter or edit data:"
echo
echo "Box03  )    Enter Benefits Paid in 2022                    "
echo "Box04  )    Enter Benefits Repaid to SSA in 2022   "
echo "Box06  )    Enter Voluntary Federal Income Tax Withheld"
echo "Box07  )    Enter Recipient's full name        "
echo "Box07a )    Enter Recipient's street address   "
echo "Box07b )    Enter Recipient's city, ST and zip "
echo "Box08  )    Enter Claim Number                 "
echo "Box03d1)    Enter descriptive text 03d1        "
echo "Box03d2)    Enter descriptive text 03d2        "
echo "Box03d3)    Enter descriptive text 03d3        "
echo "Box03d4)    Enter descriptive text 03d4        "
echo "Box03d5)    Enter descriptive text 03d5        "
echo "Box03d6)    Enter descriptive text 03d6        "
echo "Box03d7)    Enter descriptive text 03d7        "
echo "Box03d8)    Enter descriptive text 03d8        "
echo "Box03e1)    Enter descriptive amount 03e1      "
echo "Box03e2)    Enter descriptive amount 03e2      "
echo "Box03e3)    Enter descriptive amount 03e3      "
echo "Box03e4)    Enter descriptive amount 03e4      "
echo "Box03e5)    Enter descriptive amount 03e5      "
echo "Box03e6)    Enter descriptive amount 03e6      "
echo "Box03e7)    Enter descriptive amount 03e7      "
echo "Box03e8)    Enter descriptive amount 03e8      "
echo "Box04d1)    Enter descriptive text 04d1        "
echo "Box04d2)    Enter descriptive text 04d2        "
echo "Box04d3)    Enter descriptive text 04d3        "
echo "Box04d4)    Enter descriptive text 04d4        "
echo "Box04d5)    Enter descriptive text 04d5        "
echo "Box04d6)    Enter descriptive text 04d6        "
echo "Box04d2)    Enter descriptive amount 04e1      "
echo "Box04e1)    Enter descriptive amount 04e2      "
echo "Box04e2)    Enter descriptive amount 04e3      "
echo "Box04e3)    Enter descriptive amount 04e4      "
echo "Box04e4)    Enter descriptive amount 04e5      "
echo "Box04e5)    Enter descriptive amount 04e6      "
echo
echo "      q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read SSA_1099_line_data_choice
echo
     case $SSA_1099_line_data_choice in
Box03  )    set_line_menu_number $1 $2  lineBox03                          14;;
Box04  )    set_line_menu_number $1 $2  lineBox04                          14;;
Box06  )    set_line_menu_number $1 $2  lineBox06                          14;;
Box07  )    set_line_menu_text   $1 $2  lineBox07                          14;;
Box07a )    set_line_menu_text   $1 $2  lineBox07a                         14;;
Box07b )    set_line_menu_text   $1 $2  lineBox07b                         14;;
Box08  )    set_line_menu_text   $1 $2  lineBox08                          14;;
Box03d1)    set_line_menu_text   $1 $2  lineBox03d1                        14;;
Box03d2)    set_line_menu_text   $1 $2  lineBox03d2                        14;;
Box03d3)    set_line_menu_text   $1 $2  lineBox03d3                        14;;
Box03d4)    set_line_menu_text   $1 $2  lineBox03d4                        14;;
Box03d5)    set_line_menu_text   $1 $2  lineBox03d5                        14;;
Box03d6)    set_line_menu_text   $1 $2  lineBox03d6                        14;;
Box03d7)    set_line_menu_text   $1 $2  lineBox03d7                        14;;
Box03d8)    set_line_menu_text   $1 $2  lineBox03d8                        14;;
Box03e1)    set_line_menu_text   $1 $2  lineBox03e1                        14;;
Box03e2)    set_line_menu_text   $1 $2  lineBox03e2                        14;;
Box03e3)    set_line_menu_text   $1 $2  lineBox03e3                        14;;
Box03e4)    set_line_menu_text   $1 $2  lineBox03e4                        14;;
Box03e5)    set_line_menu_text   $1 $2  lineBox03e5                        14;;
Box03e6)    set_line_menu_text   $1 $2  lineBox03e6                        14;;
Box03e7)    set_line_menu_text   $1 $2  lineBox03e7                        14;;
Box03e8)    set_line_menu_text   $1 $2  lineBox03e8                        14;;
Box04d1)    set_line_menu_text   $1 $2  lineBox04d1                        14;;
Box04d2)    set_line_menu_text   $1 $2  lineBox04d2                        14;;
Box04d3)    set_line_menu_text   $1 $2  lineBox04d3                        14;;
Box04d4)    set_line_menu_text   $1 $2  lineBox04d4                        14;;
Box04d5)    set_line_menu_text   $1 $2  lineBox04d5                        14;;
Box04d6)    set_line_menu_text   $1 $2  lineBox04d6                        14;;
Box04d2)    set_line_menu_text   $1 $2  lineBox04d2                        14;;
Box04e1)    set_line_menu_text   $1 $2  lineBox04e1                        14;;
Box04e2)    set_line_menu_text   $1 $2  lineBox04e2                        14;;
Box04e3)    set_line_menu_text   $1 $2  lineBox04e3                        14;;
Box04e4)    set_line_menu_text   $1 $2  lineBox04e4                        14;;
Box04e5)    set_line_menu_text   $1 $2  lineBox04e5                        14;;
q      )    break;;                       
esac
done
}
