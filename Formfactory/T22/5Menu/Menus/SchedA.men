set_SchedA_line_data_choice() {
while true;
do
clear
echo "Lines in SchedA in which to enter or edit data:"
echo
echo "01   )    Enter medical and dental expepnses."
echo "05a  )    Enter state and local income taxes or general sales taxes."
echo "05b  )    Enter state and local real estate taxes."
echo "05c  )    Enter state and local personal property taxes."
echo "06   )    Enter other taxes.                 "
echo "08a  )    Enter home mortgage interest and points from Form 1098."
echo "08b  )    Enter home mortgage interest not from Form 1098."
echo "08c  )    Enter home mortgage points not from Form 1098."
echo "09   )    Enter investment interest.         "
echo "11   )    Enter charity gifts by cash or check."
echo "12   )    Enter charity gifts other than cash or check."
echo "13   )    Enter carryover from prior year.   "
echo "15   )    Enter casulaty and theft loss(es) from a federally declared disaster."
echo "16   )    Enter other itemized deductions    "
echo "05ack)    Enter x if you elect to include general sales taxes instead of income taxes."
echo "08ck )    Enter x if you did not use all of your mortgage loan(s) to buy, build, or improve your home."
echo "18ck )    Enter x if you elect to itemize deductions even though they are less than your standard deduction."
echo
echo "    q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read SchedA_line_data_choice
echo
     case $SchedA_line_data_choice in
01   )    set_line_menu_number $1 $2  line01                             14;;
05a  )    set_line_menu_number $1 $2  line05a                            14;;
05b  )    set_line_menu_number $1 $2  line05b                            14;;
05c  )    set_line_menu_number $1 $2  line05c                            14;;
06   )    set_line_menu_number $1 $2  line06                             14;;
08a  )    set_line_menu_number $1 $2  line08a                            14;;
08b  )    set_line_menu_number $1 $2  line08b                            14;;
08c  )    set_line_menu_number $1 $2  line08c                            14;;
09   )    set_line_menu_number $1 $2  line09                             14;;
11   )    set_line_menu_number $1 $2  line11                             14;;
12   )    set_line_menu_number $1 $2  line12                             14;;
13   )    set_line_menu_number $1 $2  line13                             14;;
15   )    set_line_menu_number $1 $2  line15                             14;;
16   )    set_line_menu_number $1 $2  line16                             14;;
05ack)    set_line_menu_text   $1 $2  line05ack                          14;;
08ck )    set_line_menu_text   $1 $2  line08ck                           14;;
18ck )    set_line_menu_text   $1 $2  line18ck                           14;;
q    )    break;;                       
esac
done
}
