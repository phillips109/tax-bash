set_Form1040_line_data_choice() {
while true;
do
clear
echo "Lines in Form1040 in which to enter or edit data:"
echo
echo "child )    If MFS enter your spouse, if HOH or QSS enter child                              "
echo "addr1 )    Enter address: line1               "
echo "addr2 )    Enter address: line2               "
echo "aptNo )    Enter address: apartment number           "
echo "city  )    Enter address: city                "
echo "ST    )    Enter address: state as ST                    "
echo "zip   )    Enter address: zip                              "
echo "FCntry)    Enter foreign address: country            "
echo "Fprov )    Enter foreign address: province        "
echo "Fzip  )    Enter foreign address: postal code                              "
echo "campme)    Enter x if you want to give $3 to campaign"
echo "campS )    Enter x if spouse wants to give $3 to campaign"
echo "digY  )    Enter x if you engaged with digital assests   "
echo "digN  )    Enter x if you did not engage with digital assets                              "
echo "youdep)    Enter x if someone can claim you as a dependent                              "
echo "Sdep  )    Enter x if someone can clain your spouse as a dependent"
echo "SiUali)    Enter x if spouse itemizes on a separate return or you were a dual-status alien                              "
echo "Ya58  )    Enter x if you were born before January 2, 1958"
echo "Yblind)    Enter x if you are blind           "
echo "Sa58  )    Enter x if your spouse was born before January 2, 1958      "
echo "Sblind)    Enter x if your spouse is blind    "
echo "d1name)    Enter first dependent's first name				    "
echo "d1LN  )    Enter first dependent's last name                                  "
echo "d1SF  )    Enter first three digits of first dependent's SS number	    "
echo "d1SM  )    Enter next two digits of first dependent's SS number		    "
echo "d1SL  )    Enter last four digits of first dependent's SS number		    "
echo "d1rel )    Enter first dependent's relationship to you			    "
echo "d1CTC )    Enter x if first dependent qualifies for Child Tax Credit	    "
echo "d1cod )    Enter x if first dependent qualifies for credit for other dependents                      "
echo "d2name)    Enter second dependent's first name				    "
echo "d2LN  )    Enter second dependent's last name                                                                "
echo "d2SF  )    Enter first three digits of second dependent's SS number	                                  "
echo "d2SM  )    Enter next two digits of second dependent's SS number		                                  "
echo "d2SL  )    Enter last four digits of second dependent's SS number		                                  "
echo "d2rel )    Enter second dependent's relationship to you			                                  "
echo "d2CTC )    Enter x if second dependent qualifies for Child Tax Credit	                                  "
echo "d2cod )    Enter x if second dependent qualifies for credit for other dependents                              "
echo "d3name)    Enter third dependent's first name				    "
echo "d3LN  )    Enter third dependent's last name                                                                "
echo "d3SF  )    Enter first three digits of third dependent's SS number	                                  "
echo "d3SM  )    Enter next two digits of third dependent's SS number		                                  "
echo "d3SL  )    Enter last four digits of third dependent's SS number		                                  "
echo "d3rel )    Enter third dependent's relationship to you			                                  "
echo "d3CTC )    Enter x if third dependent qualifies for Child Tax Credit	                                  "
echo "d3cod )    Enter x if third dependent qualifies for credit for other dependents                              "
echo "d4name)    Enter fourth dependent's first name				     "
echo "d4LN  )    Enter fourth dependent's last name                                                                "
echo "d4SF  )    Enter first three digits of fourth dependent's SS number	                                  "
echo "d4SM  )    Enter next two digits of fourth dependent's SS number		                                  "
echo "d4SL  )    Enter last four digits of fourth dependent's SS number		                                  "
echo "d4rel )    Enter fourth dependent's relationship to you			                                  "
echo "d4CTC )    Enter x if fourth dependent qualifies for Child Tax Credit	                                  "
echo "d4cod )    Enter x if fourth dependent qualifies for credit for other dependents                              "
echo "dgt4  )    Enter x if you have more than 4 dependents              "
echo "01a   )    Enter the total amount from Form(s) W-2, box 1                              "
echo "01b   )    Enter household employee wages not reported on Form(s) W-2"
echo "01c   )    Enter tip income not reported on line 1a "
echo "01d   )    Enter Medicaid waiver payments not reported on Form(s) W-2"
echo "01h   )    Enter other earned income          "
echo "01i   )    Enter nontaxable combat pay election     "
echo "04a   )    Enter nontaxable IRA distributions (usually 0)"
echo "05a   )    Enter nontaxable pension and annuity income (usually 0)                              "
echo "06cCk )    Enter x if you elect to use the lump-sum election method                              "
echo "07Ck  )    Enter x if Schedule D need not be attached"
echo "8814  )    Enter x if any tax was from Form8814"
echo "4972  )    Enter x if any tax was from Form4972"
echo "Other )    Enter x if any tax was from anothe form"
echo "tOther)    Enter the number of the other form "
echo "26    )    Enter 2022 estimated tax payments and amount applied from 2021 return"
echo "27    )    Enter earned income credit(EIC)                              "
echo "35aCk )    Enter x if Form8888 is attached    "
echo "35b1  )    Enter the first digit of your routing number "
echo "35b2  )    Enter the second digit of your routing number                              "
echo "35b3  )    Enter the third digit of your routing number "
echo "35b4  )    Enter the fourth digit of your routing number"
echo "35b5  )    Enter the fifth digit of your routing number "
echo "35b6  )    Enter the sixth digit of your routing number "
echo "35b7  )    Enter the seventh digit of your routing number"
echo "35b8  )    Enter the eight digit of your routing number "
echo "35b9  )    Enter the ninth digit of your routing number"
echo "35cCkg)    Enter x if checking account                         "
echo "35cSvg)    Enter x if savings account                         "
echo "35d1  )    Enter the first digit of your account number                               "
echo "35d2  )    Enter the second digit of your account number                              "
echo "35d3  )    Enter the third digit of your account number                               "
echo "35d4  )    Enter the fourth digit of your account number                              "
echo "35d5  )    Enter the fifth digit of your account number                                "
echo "35d6  )    Enter the sixth digit of your account number                               "
echo "35d7  )    Enter the seventh digit of your account number                            "
echo "35d8  )    Enter the eight digit of your account number                              "
echo "35d9  )    Enter the ninth digit of your account number                                "
echo "35d10 )    Enter the tenth digit of your account number                                "
echo "35d11 )    Enter the eleventh digit of your account number                                "
echo "35d12 )    Enter the twelfth digit of your account number                                 "
echo "35d13 )    Enter the thirteenth digit of your account numbe                              "
echo "35d14 )    Enter the fourteenth digit of your account number                           "
echo "35d15 )    Enter the fifteenth digit of your account number                                "
echo "35d16 )    Enter the sixteenth digit of your account number                              "
echo "35d17 )    Enter the seventeenth digit of your account number                              "
echo "36    )    Enter the amount you want applied to your 2023 estimated tax                              "
echo "38    )    Enter any estimated tax penalty    "
echo "39Y   )    Enter x if you want to allow another person to discuss the return with the IRS"
echo "39N   )    Enter x if you do not want to allow another person to discuss the return with the IRS"
echo "Dname )    Enter the disignee's name          "
echo "Dphone)    Enter the disignee's phone number  "
echo "421   )    Enter the first digit of the designee's PIN   "
echo "422   )    Enter the second digit of the designee's PIN  "
echo "423   )    Enter the third digit of the designee's PIN   "
echo "424   )    Enter the fourth digit of the designee's PIN  "
echo "425   )    Enter the fifth digit of the designee's PIN                              "
echo "Tocc  )    Enter taxpayor's occupatuion                              "
echo "431   )    Enter the first digit of the taxpayor's identity protection PIN   "
echo "432   )    Enter the second digit of the taxpayor's identity protection PI"
echo "433   )    Enter the third digit of the taxpayor's identity protection PIN                                 "
echo "434   )    Enter the fourth dgit of the taxpayor's identity protection PIN                                "
echo "435   )    Enter the fifth digit of the taxpayor's identity protection PIN                              "
echo "436   )    Enter the sixth digit of the taxpayor's identity protection PIN"
echo "Socc  )    Enter spouse's occupation                              "
echo "441   )    Enter the first digit of the spouse's identity protection PIN                              "
echo "442   )    Enter the second digit of the spouse's identity protection PI                              "
echo "443   )    Enter the third digit of the spouse's identity protection PIN                              "
echo "444   )    Enter the fourth dgit of the spouse's identity protection PIN                              "
echo "445   )    Enter the fifth digit of the spouse's identity protection PIN                              "
echo "446   )    Enter the sixth digit of the spouse's identity protection PIN                              "
echo "Pname )    Enter preparer's name                              "
echo "Pdate )                                       "
echo "PTIN  )    Enter preparer's PTN                              "
echo "SECk  )    Enter x if preparer is self-employed          "
echo "Fname )    Enter name of preparer's firm      "
echo "Fphone)    Enter phone number of preparer     "
echo "Faddr )    Enter address of preparer          "
echo "FEIN  )    Enter EIN of preparer's firm       "
echo
echo "     q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read Form1040_line_data_choice
echo
     case $Form1040_line_data_choice in
child )    set_line_menu_text   $1 $2  linechild                          14;;
addr1 )    set_line_menu_text   $1 $2  lineaddr1                          14;;
