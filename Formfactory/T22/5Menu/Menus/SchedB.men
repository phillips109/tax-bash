set_SchedB_line_data_choice() {
while true;
do
clear
echo "Lines in SchedB in which to enter or edit data:"
echo
echo "07a1y)    Enter x if, at any time during 2022, you had a financial interest in or signature authority over a financial account located in a foreign country."
echo "07a2y)    Enter x if your are required to file FinCEN Form114."
echo "07a2n)    Enter x if your are not so required."
echo "07b  )    If you are required to file FinCEN form 114, list the name(s) of the foreign country(ies) where the financial account(s) are located."
echo "08y  )    Enter x if , during 2022, you received a distribution from, or were the grantor of, or transferor to , a foreign trust. If yes, you may have to file Form 3520."
echo "08n  )    Enter x if you were not such a receiver, grantor, or transferor."
echo
echo "    q)    Return to Previous Menu"      
echo
echo "Please enter the letter(s) of your choice then press return."
     read SchedB_line_data_choice
echo
     case $SchedB_line_data_choice in
07a1y)    set_line_menu_text   $1 $2  line07a1y                          14;;
07a2y)    set_line_menu_text   $1 $2  line07a2y                          14;;
07a2n)    set_line_menu_text   $1 $2  line07a2n                          14;;
07b  )    set_line_menu_text   $1 $2  line07b                            14;;
08y  )    set_line_menu_text   $1 $2  line08y                            14;;
08n  )    set_line_menu_text   $1 $2  line08n                            14;;
q    )    break;;                       
esac
done
}
