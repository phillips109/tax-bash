importLastYrData(){
#IMPORT DATA FROM LAST YEAR'S DATA FILES

if [ -d ../../T16/Data/ ]
then
echo "Last years Data directory exists"
echo "The program will import any data files"
echo "in that directory."


cp ../../T16/Data/*_data.xml ../Data


#This takes last years data files and puts them in
#  the correct format and outputs this in a .temp file.
for file in ../Data/Background*_data.xml
do
    echo "Processing $file"
    
#This eliminates the <text/> format to make the file predictable.
#It does not insert the <number></number> line
sed 's/<instructions\/>/<instructions><\/instructions>/;s/<text\/>/<text><\/text>/;s/<number\/>/<number><\/number>/;s/<override\/>/<override><\/override>/;s/<item\/>/<item><\/item>/' ../Data/$file  >  ../Data/$file.tmp

#The next two lines eliminate any <number> lines to avoid duplication
sed '/<number>/d' ../Data/$file.tmp  >  ../Data/$file.tmp2
sed '/<number\/>/d' ../Data/$file.tmp2 > ../Data/$file.tmp3

#The next line inserts the <number> line in correct format.
sed '/<override>/i\
<number><\/number>
<goesTo>
</goesTo>
<comesFrom>
</comesFrom>' ../Data/$file.tmp3  >  ../Data/$file.tmp4

#This line was supposed to put the whole file in proper format,
#but it puts back the <text/> usage
#It may not be necessary.
#java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Data/$file.tmp4 -xsl ../Xsl/setupData.xsl -out ../Data/$file.tmp5

#This eliminates the <text/> format once more to make the file predictable.
#It also eliminates any unused <item></item> entries.
sed 's/<instructions\/>/<instructions><\/instructions>/;s/<text\/>/<text><\/text>/;s/<number\/>/<number><\/number>/;s/<override\/>/<override><\/override>/;s/<item\/>//' ../Data/$file.tmp5  >  ../Data/$file.tmp6

#This line removes any blank lines.
#This may have been done by the java step already.
sed 's/^$/d' ../Data/$file.tmp6 ../Data/$file.temp

#This moves the changes back to the original file.
mv ../Data/$file.temp ../Data/$file

done


#This line removes the .temp extension
#rename 's/.temp//' ../Data/*.temp

 

#These lines remove the T16 .tmp files.
rm ../Data/*.tmp
rm ../Data/*.tmp2
rm ../Data/*.tmp3
rm ../Data/*.tmp4
rm ../Data/*.tmp5
echo

#Here there will have to be a set of copy files to put last years 
#formatted data files (../../Data/*.temp) in the correct 
#lines (file names) for this years forms.
#This is because the formatting and logic may have changed.


echo "Last years data files have now been verified for their format."
sleep 2


else
echo "Last year's Data directory doesn't exist"
echo "This year's empty data files are now ready to use."
fi

return
}

importGnuCash(){
#IMPORT DATA FROM GNUCASH

#The location of the GnuCash backup files needs to be specified
#in the constant GNUCASHFILES.
#This is best defined by placing the following 2 lines in ~/.bashrc
#  GNUCASHFILES=~/.gnucash.data  (substitute your absolute path to the data here)
#  export GNUCASHFILES

#This line defines the constant YR
#This will make it easier to hardwire this file next year.
#YR=21
#export YR

#This line select the backup files of gnucash in reverse order.
#   Thus the desired (most recent) backup is the first in the group.
#   The break; command ensures that only this first file is used.

for file in $(dir -ra $GNUCASHFILES/*.gnucash)
do

#The name of the first file is put into foo.
foo=$file
#echo $foo

#This removes everything from the filename up to and including the 2 in $YEAR.
newname=${foo#~/*.2}
#echo $newname

#The next line puts the 2(of $YEAR) back in the name.
newername='2'$newname
#echo $newername

#This copies the file to GnuCash leaving the original backups unchanged.
cp $foo ../GnuCash/$newername.gz
#dir ..//GnuCash
#This unzips the file.
gunzip ../GnuCash/$newername.gz
#echo $newername

#This adds the .current extension expected by  refreshAll().
#dir ../GnuCash/
rm ../GnuCash/*.current
cp ../GnuCash/$newername ../GnuCash/$newername.current
dir ../GnuCash

break;

done

}


refreshAll() {
#This file creates the ../BaseData/totl.xml file for use by refreshTl().
#This file also creates ../Accounts directory with its account files which can be edited if needed.
#That is, this file does all the calculations that can be done with the GnuCash data before
#the taxpayor starts filling out the files in ../Data.

#In Ubuntu xalan is available in /usr/sbin but it points to the c version
#which has no implementation of format-number()
#I therefore used the classpath option to get the java version

echo "Your data is being refreshed. This will take about 50 seconds."
echo "Please wait for the program to return." 

#These lines empty the Accounts and Work directories
#This is probably not needed.
#rm ../Accounts/* 2 > /device/null
#rm ../Work/* 2 > /device/null

#This line removes any non-current-year transactions.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../GnuCash/*.current -xsl ../BaseXsl/year.xsl -out ../BaseData/year.xml

#This line places the transactions under their appropriate account name.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/year.xml -xsl ../BaseXsl/splita.xsl -out ../BaseData/split.xml

#This line divides all the dollarvalues by 100.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/split.xml -xsl ../BaseXsl/dollarvalue.xsl -out ../BaseData/dollarvalue.xml


#*********The next few lines would allow the creation and editing of account files *******

#This line separates the accounts into individual files in ../Accounts.init
#This directory will hold the account files as produced by GnuCash.
#This is in case you need to see your GnuCash unaltered.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/dollarvalue.xml -xsl ../BaseXsl/accounts.xsl -out ../Accounts.init/accounts.xml

#This file simply copies the account files in ../Accounts.init to ../Accounts
cp -r ../Accounts.init/* ../Accounts

#*****************************************************************************************************


#If one wants to edit an account, simply copy the account.xml file to ../Accounts.edited.
#There one can use emacs to edit the file.
#In this location the edited file will not be overwritten if the GnuCash file is updated and copied to ../Accounts.init/ and ../Accounts/

#Once edited, the file is copied on top of the corresponding file in ../Accounts/
#to maintain any edits previously made.
cp -r ../Accounts.edited/* ../Accounts

#***************************************************************************************

#This removes dollarvalue.xml to allow one to see if it is recreated.
#This line is probably not needed.
rm ../BaseData/dollarvalue.xml


#This line rejoins the individual account files into a new version of ../BaseData/dollarvalue.xml called ../BaseData/dollarvalue.xml
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Accounts/accounts.xml -xsl ../BaseXsl/rejoin.xsl -out ../BaseData/dollarvalue.xml

#*******************************************************************************************

#This line totals the transactions under each account
#This line has to occur after any editing of the accounts.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/dollarvalue.xml -xsl ../BaseXsl/totl.xsl -out ../BaseData/totl.xml

return 
}

