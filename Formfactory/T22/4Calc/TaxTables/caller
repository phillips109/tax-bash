<?xml version="1.0" encoding="UTF-8"?>

<xsl:stylesheet version="1.0"
		xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

  <xsl:output indent="yes"/>

  <xsl:variable name="Form1040-Copy00-lineFS">
    <xsl:value-of select="'S'"/>
  </xsl:variable>
  
  <xsl:variable name="Form1040-Copy00-line15">
    <xsl:value-of select="600000"/>
  </xsl:variable>

  <xsl:variable name="Form1040-Copy00-line16">
    <xsl:call-template name="taxCalc">
      <xsl:with-param name="filingStatus" select="$Form1040-Copy00-lineFS"/>
      <xsl:with-param name="lineToBeTaxed" select="$Form1040-Copy00-line15"/>
    </xsl:call-template>
  </xsl:variable>

  <xsl:template match="/">
    <IRSForms>
      <Form name="Form1040-Copy00">
	<copy00line15 color="green">
	  <xsl:value-of select="format-number($Form1040-Copy00-line15, '#####0')"/>
	</copy00line15>
	<copy00line16 color="red">
	  <xsl:value-of select="format-number($Form1040-Copy00-line16, '#####0')"/>
	</copy00line16>
      </Form>
    </IRSForms>
  </xsl:template>
  
  <xsl:template name="taxCalc">
    
    <xsl:param name="filingStatus"/>
    <xsl:param name="lineToBeTaxed"/>
    
<!-- *********************************************************************************************************** -->    
    <xsl:variable name="SBracketOne">
      <xsl:value-of select="9950"/>
    </xsl:variable>

    <xsl:variable name="SBracketTwo">
      <xsl:value-of select="40525"/>
    </xsl:variable>
    
    <xsl:variable name="SBracketThree">
      <xsl:value-of select="86375"/>
    </xsl:variable>
    
    <xsl:variable name="SBracketFour">
      <xsl:value-of select="164925"/>
    </xsl:variable>
    
    <xsl:variable name="SBracketFive">
      <xsl:value-of select="209425"/>
    </xsl:variable>
    
    <xsl:variable name="SBracketSix">
      <xsl:value-of select="523600"/>
    </xsl:variable>
    
<!-- **************************************************************************************************************** -->    

    <xsl:variable name="MFSBracketOne">
      <xsl:value-of select="9950"/>
    </xsl:variable>

    <xsl:variable name="MFSBracketTwo">
      <xsl:value-of select="40525"/>
    </xsl:variable>
    
    <xsl:variable name="MFSBracketThree">
      <xsl:value-of select="86375"/>
    </xsl:variable>
    
    <xsl:variable name="MFSBracketFourB">
      <xsl:value-of select="164925"/>
    </xsl:variable>
    
    <xsl:variable name="MFSBracketFive">
      <xsl:value-of select="209425"/>
    </xsl:variable>
    
    <xsl:variable name="MFSBracketSix">
      <xsl:value-of select="314150"/>
    </xsl:variable>
    
<!-- **************************************************************************************************************** -->    

    <xsl:variable name="HOHBracketOne">
      <xsl:value-of select="14200"/>
    </xsl:variable>

    <xsl:variable name="HOHBracketTwo">
      <xsl:value-of select="54200"/>
    </xsl:variable>
    
    <xsl:variable name="HOHBracketThree">
      <xsl:value-of select="86350"/>
    </xsl:variable>
    
    <xsl:variable name="HOHBracketFour">
      <xsl:value-of select="164900"/>
    </xsl:variable>
    
    <xsl:variable name="HOHBracketFive">
      <xsl:value-of select="209400"/>
    </xsl:variable>
    
    <xsl:variable name="HOHBracketSix">
      <xsl:value-of select="523600"/>
    </xsl:variable>
    
<!-- **************************************************************************************************************** -->    

    <xsl:variable name="MFJQWBracketOne">
      <xsl:value-of select="19900"/>
    </xsl:variable>

    <xsl:variable name="MFJQWBracketTwo">
      <xsl:value-of select="81050"/>
    </xsl:variable>
    
     <xsl:variable name="MFJQWBracketThree">
       <xsl:value-of select="172750"/>
    </xsl:variable>
    
    <xsl:variable name="MFJQWBracketFour">
      <xsl:value-of select="329850"/>
    </xsl:variable>
    
    <xsl:variable name="MFJQWBracketFive">
      <xsl:value-of select="418850"/>
    </xsl:variable>
    
    <xsl:variable name="MFJQWBracketSix">
      <xsl:value-of select="628300"/>
    </xsl:variable>
    
<!-- **************************************************************************************************************** -->    

<xsl:variable name="TaxRateBracketOne">
      <xsl:value-of select="0.10"/>
    </xsl:variable>
    
    <xsl:variable name="TaxRateBracketTwo">
      <xsl:value-of select="0.12"/>
    </xsl:variable>
    
    <xsl:variable name="TaxRateBracketThree">
      <xsl:value-of select="0.22"/>
    </xsl:variable>
    
    <xsl:variable name="TaxRateBracketFour">
      <xsl:value-of select="0.24"/>
    </xsl:variable>
    
    <xsl:variable name="TaxRateBracketFive">
      <xsl:value-of select="0.32"/>
    </xsl:variable>
    
    <xsl:variable name="TaxRateBracketSix">
      <xsl:value-of select="0.35"/>
    </xsl:variable>
    
    <xsl:variable name="TaxRateBracketSeven">
      <xsl:value-of select="0.37"/>
    </xsl:variable>
    
    <!-- ************************************************************************************************************* -->    

    <xsl:variable name="STaxOnBracketOne">
      <xsl:value-of select="round($SBracketOne * $TaxRateBracketOne)"/>
    </xsl:variable>

    <xsl:variable name="STaxOnBracketTwo">
	    <xsl:value-of select="round((($SBracketTwo - $SBracketOne) * $TaxRateBracketTwo)  + $STaxOnBracketOne)"/>
    </xsl:variable>

    <xsl:variable name="STaxOnSBracketThree">
      <xsl:value-of select="round((($SBracketThree - $SBracketTwo) * $TaxRateBracketThree)  + $STaxOnBracketTwo)"/>
    </xsl:variable>

    <!-- ****************************************************************************************************************** -->

    <xsl:variable name="MFSTaxOnBracketOne">
      <xsl:value-of select="round($MFSBracketOne * $TaxRateBracketOne)"/>
    </xsl:variable>

    <xsl:variable name="MFSTaxOnBracketTwo">
	    <xsl:value-of select="round((($MFSBracketTwo - $MFSBracketOne) * $TaxRateBracketTwo)  + $MFSTaxOnBracketOne)"/>
    </xsl:variable>

    <xsl:variable name="MFSTaxOnBracketThree">
      <xsl:value-of select="round((($MFSBracketThree - $MFSBracketTwo) * $TaxRateBracketThree)  + $MFSTaxOnBracketTwo)"/>
    </xsl:variable>

    <xsl:variable name="MFSTaxOnBracketFourA">
      <xsl:value-of select="round((($MFSBracketFourA - $MFSBracketThree)  TaxRateBracketFour )  + $MFSTaxOnBracketThree"/>
    </xsl:variable>

    <!-- ****************************************************************************************************************** -->

    <xsl:variable name="HOHTaxOnBracketOne">
      <xsl:value-of select="round($SBracketOne * $TaxRateBracketOne)"/>
    </xsl:variable>

    <xsl:variable name="HOHTaxOnBracketTwo">
	    <xsl:value-of select="round((($HOHBracketTwo - $HOHBracketOne) * $TaxRateBracketTwo)  + $HOHTaxOnBracketOne)"/>
    </xsl:variable>

    <xsl:variable name="HOHTaxOnBracketThree">
      <xsl:value-of select="round((($HOHBracketThree - $HOHBracketTwo) * $TaxRateBracketThree)  + $HOHTaxOnBracketTwo)"/>
    </xsl:variable>

    <xsl:variable name="HOHTaxOnBracketFourA">
      <xsl:value-of select="round((($HOHBracketFourA - $HOHBracketThree  $TaxRateBracketFour )  + $HOHTaxOnBracketThree"/>
    </xsl:variable>

    <!-- ****************************************************************************************************************** -->

    <xsl:variable name="MFJQWTaxOnBracketOne">
      <xsl:value-of select="round($SBracketOne * $TaxRateBracketOne)"/>
    </xsl:variable>

    <xsl:variable name="MFJQWTaxOnBracketTwo">
	    <xsl:value-of select="round((($MFJQWBracketTwo - $MFJQWBracketOne) * $TaxRateBracketTwo)  + $MFJQWTaxOnBracketOne)"/>
    </xsl:variable>

    <xsl:variable name="MFJQWTaxOnBracketThreeA">
      <xsl:value-of select="round((($MFJQWBracketThree - $MFJQWBracketTwo) * $TaxRateBracketThree)  + $MFJQWTaxOnBracketTwo)"/>
    </xsl:variable>

    <!-- ****************************************************************************************************************** -->

    <xsl:variable name="SSubtractionAmtBracketFourB">
      <xsl:value-of select="5979"/>
    </xsl:variable>

    <xsl:variable name="SSubtractionAmtBracketFive">
      <xsl:value-of select="19173"/>
    </xsl:variable>

    <xsl:variable name="SSubtractionAmtBracketSix">
      <xsl:value-of select="25455.75"/>
    </xsl:variable>

    <xsl:variable name="SSubtractionAmtBracketSeven">
      <xsl:value-of select="35927.75"/>
    </xsl:variable>
<!-- **************************************************************** -->
    <xsl:variable name="MFSSubtractionAmtBracketFourB">
      <xsl:value-of select="5979"/>
    </xsl:variable>

    <xsl:variable name="MFSSubtractionAmtBracketFive">
      <xsl:value-of select="19173"/>
    </xsl:variable>

    <xsl:variable name="MFSSubtractionAmtBracketSix">
      <xsl:value-of select="25455.75"/>
    </xsl:variable>

    <xsl:variable name="MFSSubtractionAmtBracketSeven">
      <xsl:value-of select="31738.75"/>
    </xsl:variable>

<!-- *************************************************************************************************************************** -->
    
    <xsl:variable name="HOHSubtractionAmtBracketFourB">
      <xsl:value-of select="7431"/>
    </xsl:variable>

    <xsl:variable name="HOHSubtractionAmtBracketFive">
      <xsl:value-of select="29623"/>
    </xsl:variable>

    <xsl:variable name="HOHSubtractionAmtBracketSix">
      <xsl:value-of select="26905"/>
    </xsl:variable>

    <xsl:variable name="HOHSubtractionAmtBracketSeven">
      <xsl:value-of select="37377"/>
    </xsl:variable>

<!-- *************************************************************************************************************************** -->
    
    <xsl:variable name="MFJQWSubtractionAmtBracketThreeB">
      <xsl:value-of select="8503"/>
    </xsl:variable>

    <xsl:variable name="MFJQWSubtractionAmtBracketFour">
      <xsl:value-of select="11958"/>
    </xsl:variable>

    <xsl:variable name="MFJQWSubtractionAmtBracketFive">
      <xsl:value-of select="38346"/>
    </xsl:variable>

    <xsl:variable name="MFJQWSubtractionAmtBracketSix">
      <xsl:value-of select="50911.50"/>
    </xsl:variable>

    <xsl:variable name="MFJQWSubtractionAmtBracketSeven">
      <xsl:value-of select="63477.50"/>
    </xsl:variable>

    <!-- *************************************************************************************************************************** -->
    
    <xsl:choose>
      
      <xsl:when test="$filingStatus='S'">

	<xsl:choose>
	  
	  <xsl:when test="$lineToBeTaxed > 0 and $lineToBeTaxed &lt;= $SBracketOne">
	    <xsl:value-of select="round($lineToBeTaxed * $TaxRateBracketOne)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $SBracketOne and $lineToBeTaxed &lt;= $SBracketTwo">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $SBracketOne) div 50) +0.5) *50) * $TaxRateBracketTwo)  + $STaxOnBracketOne)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $SBracketTwo and $lineToBeTaxed &lt;= $SBracketThree">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $SBracketTwo) div 50) +0.5) *50) * $TaxRateBracketThree)  + $STaxOnBracketTwo)"/>
	  </xsl:when>

	  <xsl:when test="$lineToBeTaxed > $SBracketThree and $lineToBeTaxed &lt;= 100000">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $SBracketThree) div 50) +0.5) *50) * $TaxRateBracketFour)  + $STaxOnBracketThree)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > 100000 and $lineToBeTaxed &lt;= $SBracketFour">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketFour) - $SSubtractionAmtBracketFour)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $SBracketFour and $lineToBeTaxed &lt;= $SBracketFive">
	    <xsl:value-of select="round(($lineToBeTaxed  * $TaxRateBracketFive) - $SSubtractionAmtBracketFive)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $SBracketFive and $lineToBeTaxed &lt;= $SBracketSix">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketSix) - $SSubtractionAmtBracketSix)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed &gt; $SBracketSix">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketSeven) - $SSubtractionAmtBracketSeven)"/>
	  </xsl:when>
	  
	</xsl:choose>

      </xsl:when>


      <xsl:when test="$filingStatus='MFS'">

	<xsl:choose>
	  
	  <xsl:when test="$lineToBeTaxed > 0 and $lineToBeTaxed &lt;= $MFSBracketOne">
	    <xsl:value-of select="round($lineToBeTaxed * $TaxRateBracketOne)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $MFSBracketOne and $lineToBeTaxed &lt;= $MFSBracketTwo">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $MFSBracketOne) div 50) +0.5) *50) * $TaxRateBracketTwo)  + $MFSTaxOnBracketOne)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $MFSBracketTwo and $lineToBeTaxed &lt;= $MFSBracketThree">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $MFSBracketTwo) div 50) +0.5) *50) * $TaxRateBracketThree)  + $MFSTaxOnBracketTwo)"/>
	  </xsl:when>

	  <xsl:when test="$lineToBeTaxed > $SBracketThree and $lineToBeTaxed &lt;= 100000">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $MFSBracketThree) div 50) +0.5) *50) * $TaxRateBracketFour)  + $MFSTaxOnBracketThree)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > 100000 and $lineToBeTaxed &lt;= $SBracketFour">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketFour) - $MFSSubtractionAmtBracketFour)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $MFSBracketFour and $lineToBeTaxed &lt;= $MFSBracketFive">
	    <xsl:value-of select="round(($lineToBeTaxed  * $TaxRateBracketFive) - $MFSSubtractionAmtBracketFive)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $MFSBracketFive and $lineToBeTaxed &lt;= $MFSBracketSix">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketSix) - $MFSSubtractionAmtBracketSix)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed &gt; $MFSBracketSix">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketSeven) - $MFSSubtractionAmtBracketSeven)"/>
	  </xsl:when>
	  
	</xsl:choose>

      </xsl:when>

      <xsl:when test="$filingStatus='HOH'">

	<xsl:choose>
	  
	  <xsl:when test="$lineToBeTaxed > 0 and $lineToBeTaxed &lt;= $HOHBracketOne">
	    <xsl:value-of select="round($lineToBeTaxed * $TaxRateBracketOne)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $HOHBracketOne and $lineToBeTaxed &lt;= $HOHBracketTwo">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $HOHBracketOne) div 50) +0.5) *50) * $TaxRateBracketTwo)  + $HOHTaxOnBracketOne)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $HOHBracketTwo and $lineToBeTaxed &lt;= $HOHBracketThree">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $HOHBracketTwo) div 50) +0.5) *50) * $TaxRateBracketThree)  + $HOHTaxOnBracketTwo)"/>
	  </xsl:when>

	  <xsl:when test="$lineToBeTaxed > $HOHBracketThree and $lineToBeTaxed &lt;= 100000">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $HOHBracketThree) div 50) +0.5) *50) * $TaxRateBracketFour)  + $HOHTaxOnBracketThree)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > 100000 and $lineToBeTaxed &lt;= $HOHBracketFour">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketFour) - $HOHSubtractionAmtBracketFour)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $HOHBracketFour and $lineToBeTaxed &lt;= $HOHBracketFive">
	    <xsl:value-of select="round(($lineToBeTaxed  * $TaxRateBracketFive) - $HOHSubtractionAmtBracketFive)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $HOHBracketFive and $lineToBeTaxed &lt;= $HOHBracketSix">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketSix) - $HOHSubtractionAmtBracketSix)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed &gt; $HOHBracketSix">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketSeven) - $HOHSubtractionAmtBracketSeven)"/>
	  </xsl:when>

	</xsl:choose>

      </xsl:when>

      <xsl:when test="$filingStatus='MFJ' or $FilingStatus='QW'">

	<xsl:choose>
	  
	  <xsl:when test="$lineToBeTaxed > 0 and $lineToBeTaxed &lt;= $MFJQWBracketOne">
	    <xsl:value-of select="round($lineToBeTaxed * $TaxRateBracketOne)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $MFJQWBracketOne and $lineToBeTaxed &lt;= $SMFJQWBracketTwo">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $MFJQWBracketOne) div 50) +0.5) *50) * $TaxRateBracketTwo)  + $MFJQWTaxOnBracketOne)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $MFJQW BracketTwo and $lineToBeTaxed &lt;= $MFJQW BracketThree">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $MFJQWBracketTwo) div 50) +0.5) *50) * $TaxRateBracketThree)  + $MFJQWTaxOnBracketTwo)"/>
	  </xsl:when>

	  <xsl:when test="$lineToBeTaxed > $MFJQWBracketThree and $lineToBeTaxed &lt;= 100000">
	    <xsl:value-of select="round((((floor(($lineToBeTaxed - $MFJQWBracketThree) div 50) +0.5) *50) * $TaxRateBracketFour)  + $MFJQWTaxOnBracketThree)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > 100000 and $lineToBeTaxed &lt;= $MFJQWBracketFour">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketFour) - $MFJQWSubtractionAmtBracketFour)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $MFJQWBracketFour and $lineToBeTaxed &lt;= $MFJQWBracketFive">
	    <xsl:value-of select="round(($lineToBeTaxed  * $TaxRateBracketFive) - $MFJQWSubtractionAmtBracketFive)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed > $MFJQWBracketFive and $lineToBeTaxed &lt;= $MFJQWBracketSix">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketSix) - $MFJQWSubtractionAmtBracketSix)"/>
	  </xsl:when>
	  
	  <xsl:when test="$lineToBeTaxed &gt; $MFJQWBracketSix">
	    <xsl:value-of select="round(($lineToBeTaxed * $TaxRateBracketSeven) - $MFJQWSubtractionAmtBracketSeven)"/>
	  </xsl:when>
	  
	</xsl:choose>

      </xsl:when>
      
    </xsl:choose>
      
  </xsl:template>
  
</xsl:stylesheet>
