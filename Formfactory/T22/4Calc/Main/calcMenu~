  echo "  20)  export ../Variables/* to ../../7App/Variables/"
  echo "       export ../Lines/*     to ../../7App/Lines/"
  echo
  echo "   q) Quit"
  echo "Please enter the number or letter(s) of your choice then press return."
  read menu_choice

    case "$menu_choice" in
     1a)  Pdfshow $1;;	
     1b)  importTxt $1;;
     1c)  cptxt2edit $1;;
     1d)  editTxt $1;;
     1e)  sortSeq $1;;
     1f)  editSort $1;;
     1g)  makePreDat $1 $2;;
     1h)  cpPre2EdPre $1 $2;;
     1i)  editEdPre $1 $2;;
     1j)  rmEndSpaceField $1 $2;;
     1k)  editDat $1 $2;;
    
      2)  makeInput $1 $2;;
      3)  makeDataFiles $1 $2;;
      4)  makeVariables $1 $2;;
      5)  makeLines $1 $2;;
      6)  makeXsl $1 $2;;
      7)  makeTotal $1 $2;;
      8)  makeTaxlines $1 $2;;
      9)  makeOutput $1 $2;;
     10)  showOutput $1 $2;;
     11)  2-10 $1 $2;;

     13)  importLayoutData $1 $2;;

     14)  importJpg $1;;
     15)  import2Fo $1 $2;;
     
     16)  makeFo $1 $2;;
     17)  makePdf $1 $2;;
     18)  showPdf $1 $2;;
     19)  16-18 $1 $2;;
     
     20)  exportVariables
     	  exportLines;;
	  
      q)  exit;;
      *)  echo "Sorry, choice not recognized."
    esac
  done  
}

