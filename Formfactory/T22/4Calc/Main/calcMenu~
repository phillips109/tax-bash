set_menu_choices() {
while true;
  do     
#  clear
  echo
  echo "This menu is for Developers writing the math of a form."
  echo "  1a)  Show the image of the form you will be developing."
  echo "  1b)  Import ../../2Sequence/Text/"$1".text to ../Text/"$1".txt"
  echo "  1c)  Copy ../Text/"$1".txt to ../Edit/"$1".edit"
  echo "  1d)  Edit ../Edit/"$1".edit"
  echo "  1e)  sort ../Edit/"$1".edit to ../Sort/"$1".srt"
  echo "  1f)  view ../Sort/"$1".srt"
  echo "  1g)  convert to ../PreDat/"$1"_Copy$2.pre, a blank Dat awk database"
  echo "  1h)  cp ../PreDat/"$1"_Copy$2.pre to ../EdPre/$1_Copy$2.edpre"
  echo "  1i)  Edit ../EdPre/$1_Copy$2.edpre"
  echo "  1j)  rmEndSpaceField of ../EdPre/"$1"_Copy"$2".edpre > ../Dat/"$1"_Copy"$2".dat"
  echo "  1k)  view ../Dat/"$1"_Copy"$2".dat"
  echo "   2)  makeInput"
  echo "   3)  make ../Data/"$1"_Copy"$2"_line*.xml files"
  echo "   4)  make ../Variables/v"$1"_Copy"$2".xsl"
  echo "   5)  make ../Lines/l"$1"_Copy"$2".xml"
  echo "   6)  make ../Xsl/"$1"Copy"$2".xsl and ../Xsl/taxlogic.xsl"
  echo "   7)  make ../Total/totl"$1"_Copy"$2".xml"
  echo "   8)  make ../Taxlines/lines"$1"_Copy"$2".xml" 
  echo "   9)  make ../Output/"$1"_Copy"$2".xml"
