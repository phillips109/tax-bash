work_with_accounts() {
while true;
  do     
      clear
  echo " Working with Accounts (GnuCash data)"         
  echo

  echo "   1) List the names of all of the accounts in your GnuCash data."
  echo "   2) List the transactions in a specified account."
  echo "   3) Show the accounts and transactions used for a specified form."
  echo 
  echo "   q) Return to main menu."
 
  echo "Please enter the number or letter(s) of your choice then press return."
  read menu_choice

    case "$menu_choice" in

      1) listAccounts;;
      2) oneAcct;;
      3) showAccounts;;
      
      q)  break;;
      *)  echo "Sorry, choice not recognized."
    esac
  done  
}
