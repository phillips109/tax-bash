refreshTl() {

#This file refreshes the data starting with ../BaseData/totl.xml. created at the end of RefreshAll()
#It takes about half the time required by starting with gnucash file.
#fs = [ java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Data/Bkg_Copy00_lineFS
#If text [ -f ../Data/Bkg_Copy00_lineFS.text.xml ]
#   then
#      echo "File ../Data/Bkg_Copy00_lineFS.text.xml exists."
#      fs=[ java $XALANJAVAJAR org.apache.xalan.xslt.Process -in   
#else
#	echo "File ../Data/Bkg_Copy_lineFS.text.xml doesn't exist."
#	echo "Please enter data into Bkg Form."

#if [ -f ../Data/Bkg_Copy00_lineFS_text.xml ]
#   then
#	echo "File ../Data/Bkg_Copy00_lineFS_text.xml exists."
#	java -$XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Data/Bkg_Copy00_lineFS_text.xsl -xsl ../Xsl/readFS.xsl -out -
#else
#	echo "File ../Data/Bkg_Copy00_lineFS_text.xml doesn't exist."
#	echo "Install/Open Form Bkg to enter your filing status."
#fi
	

echo "Your data is being refreshed. This will take about 30 seconds."
echo "Please wait for the program to return." 


#The next line primes ../BaseData/totl.xml created in refreshAll to attach ../Xml/All.xml created in previous step
sed 's/<\/IRSForms>/include(\.\.\/Xml\/all.xml)<\/IRSForms>/' ../BaseData/totl.xml > ../BaseData/sedtotl.xml

#This lines removes ../Xml/all.xml to make room for a new version.
#rm ../Xml/$1_Copy$2.xml
rm ../Xml/all.xml

#These lines create ../Xml/all.xml by amalgamating the data files in ../Data.
cat ../Data/*.xml >> ../Xml/all.xml

#This line adds the ../Xml/all.xml lines to the end of ../BaseData/sedtotl.xml  to get ../Total/totlall.xml
m4 ../BaseData/sedtotl.xml > ../Total/totlall.xml

#This line puts the accounts under the proper taxlines.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Total/totlall.xml -xsl ../BaseXsl/taxlines.xsl -out ../Taxlines/linesall.xml

#This works. There are no Form1040 variables in the xsl, but the file refers to taxlines file.
#java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Taxlines/linesall.xml  -xsl ../Xsl/SchedA_Copy01.xsl -out ../Output/all.xml

#This line uses the logic in taxlogic.xsl to create the final data.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Taxlines/linesall.xml  -xsl ../Xsl/taxlogic.xsl -out ../Output/all.xml

#This changes the -Copy for _Copy in all.xml
sed 's/-Copy/_Copy/' ../Output/all.xml > ../Output/all.tmp
cp ../Output/all.tmp ../Output/all.xml
rm ../Output/all.tmp

#This line will split ../Output/all.xml into individual files for each form.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Output/all.xml -xsl ../BaseXsl/makeOutputFiles.xsl -out ../Out/outputforms.xml

return 
}

