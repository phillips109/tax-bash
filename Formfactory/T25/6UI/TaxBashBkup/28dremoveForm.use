removeForm(){
        echo "Please enter the number of the copy"
	echo "   of Form&1 you wish to remove."
	read number
	echo "You are about to remove copy"$number" of "$1"."
	echo "These are the files that will be removed:"


#I decided to leave the old data so that, if you decide to resurect it, the data is still there.

#	dir ../Data/$1_Copy$number*
	dir ../2Fo/$1_Copy$number*
	dir ../MyVariables/v$1_Copy$number*
	dir ../MyLines/l$1_Copy$number*
	dir ../Output/all.xml
	dir ../Output/$1_Copy$number*
	
	echo "Are you sure you want to remove these files?"
	echo "Enter y or n."
	read this
	if yOrn "$this"
	   then
#	     rm ../Data/$1_Copy$number*
	     rm ../2Fo/$1_Copy$number*
	     rm ../MyVariables/v$1_Copy$number*
	     rm ../MyLines/l$1_Copy$number*
	     rm ../Output/all.xml
	     rm ../Output/$1_Copy$number*

#This line recreates ../Xsl/taxlogic from the remaining MyVaribles and MyLines
#Thus the logic in ../Xsl/taxlogic will not see any xsl from the removed form
	     ../BaseXsl/maketaxlogicXsl.sh
#This line recreates ../Output/all.xml and its derivative form specific files
	     refreshTl
	    
else
	     echo "$1_Copy$number will not be removed."
	fi     
}