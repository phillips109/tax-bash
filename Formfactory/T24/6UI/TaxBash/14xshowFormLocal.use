showFormLocal() {
#This is the version of showForm to be called from a particular line. It displays the line with yellow background color.

#The $# is the number of parameters.     
params=$#
echo "$params"
if [ $params = "3" ]; then
    infile="../Data/$1_Copy$2_$3_*.xml"
    tempfile="../Data/$1_Copy$2_$3_*.tmp"
elif [ $params = "4" ]; then
    infile="../Data/$1_Copy$2_$3_*.xml"
    tempfile="../Data/$1_Copy$2_$3_*.tmp"
fi
echo "infile is $infile. tempfile=$tempfile."

#This sets the background-color to yellow for the line.
sed '/<bgcolor>/s/^.*$/<bgcolor>yellow<\/bgcolor>/' $infile > $tempfile
mv $tempfile $infile

showForm $1 $2


#This restores the back-ground color to blank.
sed '/<bgcolor>/s/^.*$/<bgcolor><\/bgcolor>/' $infile > $tempfile
mv $tempfile $infile

return
}

