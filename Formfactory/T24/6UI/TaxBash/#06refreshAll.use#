refreshAll() {
#This file creates the ../BaseData/totl.xml file for use by refreshTl().
#This file also creates ../Accounts directory with its account files which can be edited if needed.
#That is, this file does all the calculations that can be done with the GnuCash data before
#the taxpayor starts filling out the files in ../Data.

#In Ubuntu xalan is available in /usr/sbin but it points to the c version
#which has no implementation of format-number()
#I therefore used the classpath option to get the java version

echo "Your data is being refreshed. This will take about 50 seconds."
echo "Please wait for the program to return." 

#These lines empty the Accounts and Work directories
#This is probably not needed.
#rm ../Accounts/* 2 > /device/null
#rm ../Work/* 2 > /device/null

#This line removes any non-current-year transactions.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../GnuCash/*.current -xsl ../BaseXsl/year.xsl -out ../BaseData/year.xml

#This line places the transactions under their appropriate account name.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/year.xml -xsl ../BaseXsl/splita.xsl -out ../BaseData/split.xml

#This line divides all the dollarvalues by 100.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/split.xml -xsl ../BaseXsl/dollarvalue.xsl -out ../BaseData/dollarvalue.xml


#*********The next few lines would allow the creation and editing of account files *******

#This line separates the accounts into individual files in ../Accounts.init
#This directory will hold the account files as produced by GnuCash.
#This is in case you need to see your GnuCash unaltered.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/dollarvalue.xml -xsl ../BaseXsl/accounts.xsl -out ../Accounts.init/accounts.xml

#This file simply copies the account files in ../Accounts.init to ../Accounts
cp -r ../Accounts.init/* ../Accounts

#*****************************************************************************************************


#If one wants to edit an account, simply copy the account.xml file to ../Accounts.edited.
#There one can use emacs to edit the file.
#In this location the edited file will not be overwritten if the GnuCash file is updated and copied to ../Accounts.init/ and ../Accounts/

#Once edited, the file is copied on top of the corresponding file in ../Accounts/
#to maintain any edits previously made.
cp -r ../Accounts.edited/* ../Accounts

#***************************************************************************************

#This removes dollarvalue.xml to allow one to see if it is recreated.
#This line is probably not needed.
rm ../BaseData/dollarvalue.xml


#This line rejoins the individual account files into a new version of ../BaseData/dollarvalue.xml called ../BaseData/dollarvalue.xml
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Accounts/accounts.xml -xsl ../BaseXsl/rejoin.xsl -out ../BaseData/dollarvalue.xml

#*******************************************************************************************

#This line totals the transactions under each account
#This line has to occur after any editing of the accounts.
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/dollarvalue.xml -xsl ../BaseXsl/totl.xsl -out ../BaseData/totl.xml

return 
}
