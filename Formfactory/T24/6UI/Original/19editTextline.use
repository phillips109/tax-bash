
edit_textline(){
#This fuction edits the text value of a data file.
#The value of this line is shown as <text> in the data file:

#The $# is the number of parameters.     
#params=$#
#echo "$params"
#if [ $params = "3" ]; then
#    infile="../Data/$1_$2_text.xml"
#    tempfile="../Data/$1_$2_text.tmp"
#elif [ $params = "4" ]; then
    infile="../Data/$1_Copy$2_$3_text.xml"
    tempfile="../Data/$1_Copy$2_$3_text.tmp"
#fi
echo "infile is $infile. tempfile=$tempfile."

#The next two lines remove any blank lines or lines containing only spaces.
sed '/^ *$/d' $infile > $tempfile
mv $tempfile $infile

#This removes any leading spaces.
sed 's/^ *//' $infile > $tempfile
mv $tempfile $infile

#The next two lines change <text/> to <text></text> if necessary.
sed 's/<text\/>/<text><\/text>/' $infile > $tempfile 
mv $tempfile $infile

#The next two lines show the <text> line in the data file.
echo
echo "The value of this line is currently:"
java $XALANJAVAJAR org.apache.xalan.xslt.Process -in $infile -xsl ../BaseXsl/textout.xsl

#sed -n '/<text>/s/<text>//;s/<\/text>//p' $infile
#pattern=$infile//text
#echo $pattern

#Now you can choose to change the line or leave it unchanged.
#The function yOrn returns 0 if y, 1 if n.
echo
echo "Do you wish to change the value of this text line?" 
echo "Enter y or n"
read this
if yOrn "$this"
   then
       echo
       echo "To change the text value of this line, please enter the new value now:"
       read text
#       sed '/<text>/s/<text>.*<\/text>/<text>'"$text"'<\/text>/' $infile > $tempfile 
#       mv $tempfile $infile
       java $XALANJAVAJAR org.apache.xalan.xslt.Process -in $infile -xsl ../BaseXsl/textin.xsl -out $tempfile -PARAM text "$text"
#      cat $tempfile
       mv $tempfile $infile
       echo
       #Now you are shown the final value of the text line. 
       echo "This text line now reads:"
       java $XALANJAVAJAR org.apache.xalan.xslt.Process -in $infile -xsl ../BaseXsl/textout.xsl
#       sed -n '/<text>/s/<text>//;s/<\/text>//p' $infile
       echo	
       #This is not applicable to text files.
#       echo "Remember that this change will not show up"
#       echo "until you have refreshed (recalculated) your data."
#       echo "Since refreshing your data takes about 30 seconds,"
#       echo "You may wish to make other changes to your data"
#       echo "before you recalculate all your data."
#       echo 
#       echo "Do you wish to refresh your data now?"
#       echo "This will take about 30 seconds."
#       echo "Enter y or n"
#       read this
#       if yOrn "$this"
#	   then
#	       refreshTl $1 $2
#       else
#       echo "Data has not been refreshed."
#       fi
else
    echo
    echo "The text value has been kept unchanged."
fi    



return
}

