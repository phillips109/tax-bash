
showDataFile(){
clear
#The $# is the number of parameters.     
params=$#
#echo "$params"
#echo $1
#echo $2
#echo $3
if [ $params = "3" ]; then
    infile="../Data/$1_Copy$2_$3_*.xml"
    tempfile="../Data/$1_Copy$2_$3_*.tmp"
elif [ $params = "4" ]; then
    infile="../Data/$1_Copy$2_$3_*.xml"
    tempfile="../Data/$1_Copy$2_$3_*.tmp"
fi
#echo "infile is $infile tempfile=$tempfile"

#The next two lines remove any blank lines or lines containing only spaces.
sed '/^ *$/d' $infile > $tempfile
mv $tempfile $infile

#This removes any leading spaces.
sed 's/^ *//' $infile > $tempfile
mv $tempfile $infile

#This removes any blank items, i.e. <item></item>
sed '/<item><\/item>/d' $infile > $tempfile
mv $tempfile $infile

#clear

cat $infile
echo " "
echo "Are you ready to continue?"
echo "If so, press y or n."
read this
if yOrn $this
then
	return
fi
}

