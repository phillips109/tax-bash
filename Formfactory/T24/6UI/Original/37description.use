
description(){
    while true;
    do
    clear
    echo
    echo "1) View description of tax-bash"
    echo "   and how to use it."
    echo
    echo "q) quit"
    echo
    echo "Enter q to return to the previous menu."
    read choice
    
    case "$choice" in
        1)viewReadMe;;
	q) break;;
    esac
done
    
}

