importLastYrData(){

if [ -d ../../T16/Data/ ]
then
echo "Last years Data directory exists"
echo "The program will import any data files"
echo "in that directory."


cp ../../T16/Data/*_data.xml ../Data


for file in ../Data/Background*_data.xml
do
    echo "Processing $file"
    
sed 's/<instructions\/>/<instructions><\/instructions>/;s/<text\/>/<text><\/text>/;s/<number\/>/<number><\/number>/;s/<override\/>/<override><\/override>/;s/<item\/>/<item><\/item>/' ../Data/$file  >  ../Data/$file.tmp

sed '/<number>/d' ../Data/$file.tmp  >  ../Data/$file.tmp2
sed '/<number\/>/d' ../Data/$file.tmp2 > ../Data/$file.tmp3

sed '/<override>/i\
<number><\/number>
<goesTo>
</goesTo>
<comesFrom>
</comesFrom>' ../Data/$file.tmp3  >  ../Data/$file.tmp4


sed 's/<instructions\/>/<instructions><\/instructions>/;s/<text\/>/<text><\/text>/;s/<number\/>/<number><\/number>/;s/<override\/>/<override><\/override>/;s/<item\/>//' ../Data/$file.tmp5  >  ../Data/$file.tmp6

sed 's/^$/d' ../Data/$file.tmp6 ../Data/$file.temp

mv ../Data/$file.temp ../Data/$file

done



 

rm ../Data/*.tmp
rm ../Data/*.tmp2
rm ../Data/*.tmp3
rm ../Data/*.tmp4
rm ../Data/*.tmp5
echo



echo "Last years data files have now been verified for their format."
sleep 2


else
echo "Last year's Data directory doesn't exist"
echo "This year's empty data files are now ready to use."
fi

return
}



importGnuCash(){




for file in $(dir -ra $GNUCASHFILES/*.gnucash)
do

foo=$file

newname=${foo#~/*.2}

newername='2'$newname

cp $foo ../GnuCash/$newername.gz
gunzip ../GnuCash/$newername.gz

rm ../GnuCash/*.current
cp ../GnuCash/$newername ../GnuCash/$newername.current
dir ../GnuCash

break;

done

}




refreshAll() {


echo "Your data is being refreshed. This will take about 50 seconds."
echo "Please wait for the program to return." 


java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../GnuCash/*.current -xsl ../BaseXsl/year.xsl -out ../BaseData/year.xml

java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/year.xml -xsl ../BaseXsl/splita.xsl -out ../BaseData/split.xml

java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/split.xml -xsl ../BaseXsl/dollarvalue.xsl -out ../BaseData/dollarvalue.xml



java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/dollarvalue.xml -xsl ../BaseXsl/accounts.xsl -out ../Accounts.init/accounts.xml

cp -r ../Accounts.init/* ../Accounts




cp -r ../Accounts.edited/* ../Accounts


rm ../BaseData/dollarvalue.xml


java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Accounts/accounts.xml -xsl ../BaseXsl/rejoin.xsl -out ../BaseData/dollarvalue.xml


java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../BaseData/dollarvalue.xml -xsl ../BaseXsl/totl.xsl -out ../BaseData/totl.xml

return 
}



refreshTl() {


	

echo "Your data is being refreshed. This will take about 30 seconds."
echo "Please wait for the program to return." 


sed 's/<\/IRSForms>/include(\.\.\/Xml\/all.xml)<\/IRSForms>/' ../BaseData/totl.xml > ../BaseData/sedtotl.xml

rm ../Xml/all.xml

cat ../Data/*.xml >> ../Xml/all.xml

m4 ../BaseData/sedtotl.xml > ../Total/totlall.xml

java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Total/totlall.xml -xsl ../BaseXsl/taxlines.xsl -out ../Taxlines/linesall.xml


java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Taxlines/linesall.xml  -xsl ../Xsl/taxlogic.xsl -out ../Output/all.xml

sed 's/-Copy/_Copy/' ../Output/all.xml > ../Output/all.tmp
cp ../Output/all.tmp ../Output/all.xml
rm ../Output/all.tmp

java $XALANJAVAJAR org.apache.xalan.xslt.Process -in ../Output/all.xml -xsl ../BaseXsl/makeOutputFiles.xsl -out ../Out/outputforms.xml

return 
}




